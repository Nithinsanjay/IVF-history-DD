    <!--Added By Devendra for Default selecting print option.  -->
    <!--
  To change can refer this:-
  
  100 => Complaints
	101 => Diagnosis
	102 => Examination
	103 => Clinical Notes
	104 => Vital Data
	105 => Investigations/Procedures
	106 => Instructions
	107 => Rx
	108 => Advice
	109 => Personal History
	110 => Medical History
	111 => Family History
	112 => Allergy
	
  -->
    <add key="DEFAULTPRINTOPTION" value="101,102,103,104,107,108"/>

