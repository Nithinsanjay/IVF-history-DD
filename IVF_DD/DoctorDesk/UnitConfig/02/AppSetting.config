    <!--
        Author        : Dhananjay
        Date          : 2026-04-07
        Feature       : Blinking Functionality for Selected Forms

        Description   :
        Enables blinking functionality for specific forms within the CIMS module.

        Applicable Forms :
        - TrmtntOrderMedicineTable
        - ChemoListtable
        - RxListtable
        - ChemoPlanningTable

        Configuration :
        Provide a comma-separated list of form short codes for which blinking
        functionality should be enabled.

        Example :
          -> TrmtntOrderMedicineTable
          -> ChemoListtable
          -> RxListtable
          -> ChemoPlanningTable
          -> TrmtntOrderMedicationTable
          -> PreOPMeds
          -> Medicine
    -->
    <add key="CIMS_BLINKING_ENABLE_FORMS" value="TrmtntOrderMedicineTable,ChemoListtable,RxListtable,ChemoPlanningTable,TrmtntOrderMedicationTable,PAC"/>

    <!--
				Author        : Dhananjay
				Date          : 2026-04-07
				Feature       : Enable Button Icons

				Description   :
				Controls the visibility of button icons based on configuration values.

				Configuration :
				Key   : CIMS_VISIBLE_ICONS
				Value : Comma-separated short codes representing icons to display.

				Supported Codes :
						I - Interaction
						D - Duplicate
						A - Allergy

				Example :
						I,D,A   → Displays Interaction, Duplicate, and Allergy icons
		-->
    <add key="CIMS_VISIBLE_ICONS" value="I,D,A" />
