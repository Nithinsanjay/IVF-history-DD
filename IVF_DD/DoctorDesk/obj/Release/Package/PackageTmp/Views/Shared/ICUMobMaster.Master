                    //lst.style.display = "none";//commented by vijeta on 1st june 2018
                    //$("#sideList").fadeOut(2000); commented by kavita
                }
            }

            $('#listCriticl').click(function (e) {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    var strIPNO = $.session.get('ICUPatIPNO');
                    window.location.href = '../ICUMob/CriticalCareGraph1?strIPNO=' + strIPNO + '&&strDate=' + strDate;
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });

            $("#listRespiratory").click(function () {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    window.location.href = 'RespiratoryAssessment?strDate=' + strDate;
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });
            $("#listMaxTemp").click(function () {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    window.location.href = 'DateWiseMaxTempReport?strDate=' + strDate;
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });
            $("#listInvestChart").click(function () {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    window.location.href = 'InvestigationChart?strDate=' + strDate;
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });
            $("#listDiabeticChart").click(function () {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    window.location.href = 'DiabeticChart?strDate=' + strDate;
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });
            $("#listDiacom").click(function () {
                $.loader.open();
                if (CheckPatSessionNotEmpty()) {
                    var Mrno = ($.session.get('ICUPatMRNO')).toString();
                    if (Mrno != "") {
                        //window.location.href = '../DoctorDesk/RedirectToDicom?mrNo=' + Mrno;// 'http://103.59.215.74:8081/SampleViewer/index?mrno=' + Mrno;
                        $.ajax({
                            type: 'POST',
                            url: 'RedirectToDicom',
                            data: { mrNo: Mrno },
                            success: function (data) {
                                $.loader.close();
                                window.open(data, '_blank');
                            },
                            error: function () {
                                $.loader.close();
                            },
                        });
                    }
                }
                else
                    $.messager.alert("Information", "Please Select Patient");

                $.loader.close();

            });
            $("#listInvestReport").click(function () {
                if (CheckPatSessionNotEmpty()) {
                    var strDate = $("#Reportdate").val();
                    window.location.href = '../ICUMob/InvestigationReport';
                }
                else
                    $.messager.alert("Information", "Please Select Patient");
            });
