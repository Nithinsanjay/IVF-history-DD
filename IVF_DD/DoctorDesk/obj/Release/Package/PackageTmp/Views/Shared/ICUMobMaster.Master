    <script type="text/javascript">
        var timoutWarning = 1500000// 840000; // Display warning in 14 Mins.
        var timoutNow = 1800000 // Timeout in 30 mins.
        var logoutUrl = '../Account/Login'; // URL to logout page.
        var warningTimer;
        var timeoutTimer;
        var NotificURl = '';
        var formname = "";
        var stopProp = true;
        var userid = '<%:Session["gOncoUserId"].ToString() %>';//Somnath
        $(document).ajaxError(function (e, jqxhr, settings, exception) {
            e.stopPropagation();
            if (jqxhr.status == 401)
                window.location.href = "../Error/unauthorized";
            else if (jqxhr.status.toString().startsWith("4") || jqxhr.status.toString().startsWith("5")) {
               // window.location.href = "../Error/index?statuscode=" + jqxhr.status;
            }
        });

       

        // Start timers.
        function StartTimers() {
            warningTimer = setTimeout("IdleWarning()", timoutWarning);
            timeoutTimer = setTimeout("IdleTimeout()", timoutNow);
        }
        // Reset timers.
        function ResetTimers() {

            if (window.localStorage.getItem("logged_in") == 'false') {
                window.location.href = "about:blank";
            }

            clearTimeout(warningTimer);
            clearTimeout(timeoutTimer);
            StartTimers();

        }

        //window.addEventListener("load", function () {                //for  removing address bar in mobile
        //    setTimeout(function () {
        //        // This hides the address bar:
        //        window.scrollTo(0, 1);
        //    }, 0);
        //});
        // Show idle timeout warning dialog.
        function IdleWarning() {
            MsgDia("Session About To Timeout, You will be logged out in 5 min.To remain logged in move your mouse over this window. ", "Warning");
        }

        function IdleTimeout() {
            window.location = logoutUrl;
        }

