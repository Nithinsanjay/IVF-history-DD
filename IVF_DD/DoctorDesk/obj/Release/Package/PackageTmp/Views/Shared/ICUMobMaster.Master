        function SetDateTime1() {
            var admissiondate = $.session.get('ICUPatAdmnDate');
            var today = new Date();
            var dd = today.getDate();
            var mm = today.getMonth() + 1;
            var yyyy = today.getFullYear();
            if (dd < 10) {
                dd = '0' + dd
            }
            if (mm < 10) {
                mm = '0' + mm
            }
            today = dd + '/' + mm + '/' + yyyy;
            $("#Reportdate").val(today);

            $("#Reportdate").datepicker(
                        {
                            showButtonPanel: true,
                            changeMonth: true,
                            yearRange: "c-150:c+99",
                            changeYear: true,
                            dateFormat: "dd/mm/yy",
                            maxDate: new Date(),
                            minDate: admissiondate
                        });

            //   MinDate();

        }

        var AdminLTEOptions = {
            enableBSToppltip: false
        };

        // element.requestFullscreen();

        //Done By sOMNATH
        function BtnTxtHideDisb() {
            $('#txtNPwd').attr("disabled", true);
            $('#txtConfirmPwd').attr("disabled", true);
            // $('#btnPass').hide();
        }

        function SaveAction() {
            if (Validation() == false || ConfirmPassWord() == false) {
                return false;
            }
            else {
                uid = $('#txtUid').val();
                Npwd = $('#txtNPwd').val();
                Cpwd = $('#txtConfirmPwd').val();
                var datatosend = { uid: uid, Npwd: Npwd, Cpwd: Cpwd }
                // ajaxindicatorstart('Saving data.. please wait..');

                $.ajax({
                    type: "POST",
                    url: '../DoctorDesk/ChangePWD',
                    data: datatosend,
                    dataType: "json",
                    cache: false,
                    success: function (response) {
                        $("#btnClosePass").click();
                        $.messager.alert("Information", response);
                        //ajaxindicatorstop();
                        ClearTxtbx();
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        // ajaxindicatorstop();
                        $.messager.alert(textStatus, "Error Information");
                    }
                })
            }
        }

        function ClearTxtbx() {
            $('#txtOPwd').val("");
            $('#txtNPwd').val("");
            $('#txtConfirmPwd').val("");
        }

        function ConfirmPassWord() {
            var a = $("#txtNPwd").val();
            var b = $("#txtConfirmPwd").val();
            if (a === b) {
                return true;
            }
            else {
                $("#btnClosePass").click();
                $.messager.alert("Information", "Password does not match!");
                $('#txtConfirmPwd').val("");
                return false;
            }
        }

        function Makenormal() {
            if (("" + $("#txtUid").val()).trim().length != 0) {
                $("#txtUid").css({ 'border-color': '' });
            }
            if (("" + $("#txtOPwd").val()).trim().length != 0) {
                $("#txtOPwd").css({ 'border-color': '' });
            }
            if (("" + $("#txtNPwd").val()).trim().length != 0) {
                $("#txtNPwd").css({ 'border-color': '' });
            }
            if (("" + $("#txtConfirmPwd").val()).trim().length != 0) {
                $("#txtConfirmPwd").css({ 'border-color': '' });
            }
        }

        function RemoveBorder() {
            if ($("#txtUid").val() == "") {
                $("#txtUid").css({ 'border-color': '' });
            }
            if ($("#txtOPwd").val() == "") {
                $("#txtOPwd").css({ 'border-color': '' });
            }
            if ($("#txtNPwd").val() == "") {
                $("#txtNPwd").css({ 'border-color': '' });
            }
            if ($("#txtConfirmPwd").val() == "") {
                $("#txtConfirmPwd").css({ 'border-color': '' });
            }
        }

        function Validation() {
            var i = 0;
            if (("" + $("#txtUid").val()).trim().length == 0) {
                $("#txtUid").focus();
                $("#txtUid").css({ 'border-color': 'red' });
                i = 1;
            }
            else {
                $("#txtUid").css({ 'border-color': '' });

            }
            if (("" + $("#txtOPwd").val()).trim().length == 0) {
                //$("#txtOPwd").focus();
                $("#txtOPwd").css({ 'border-color': 'red' });
                i = 1;
            }
            else {
                $("#txtOPwd").css({ 'border-color': '' });


                if (("" + $("#txtNPwd").val()).trim().length == 0) {
                    $("#txtNPwd").focus();
                    $("#txtNPwd").css({ 'border-color': 'red' });
                    i = 1;
                }
                else {
                    $("#txtNPwd").css({ 'border-color': '' });

                }
                if (("" + $("#txtConfirmPwd").val()).trim().length == 0) {
                    $("#txtConfirmPwd").focus();
                    $("#txtConfirmPwd").css({ 'border-color': 'red' });
                    i = 1;
                }
                else {
                    $("#txtConfirmPwd").css({ 'border-color': '' });

                }
            }

            if (i == 1) {
                return false;
            }
            else {
                return true;
            }
        }
        function ActiveMenu(liObject) {
            formname = liObject;
            $('#tabMenuUl1').children().each(function () {
                if ($(this).hasClass('active')) {
                    $(this).removeClass('active');
                }
            });
            $("#tabMenuUl1 li#" + liObject + "").addClass("active");
        }
        function MsgDia(messages, titles, RedirectPath) {
            if (titles == "Information") {
                $("#MsgImgID").attr("src", "../Images/dialog-information.png");
            }
            else if (titles == "Validation") {
                $("#MsgImgID").attr("src", "../Images/exclamation-Icon.png");
            }
            else if (titles == "Error Information") {
                $("#MsgImgID").attr("src", "../Images/Error-icon.png");
            }
            else {
                $("#MsgImgID").attr("src", "");
            }
            $("#ErrorLabel").text(messages);
            $('#ptdialog').dialog({
                autoOpen: true,
                width: 280,
                minHeight: 150,
                maxHeight: 150,
                resizable: false,
                title: titles,
                modal: true,
                buttons: {
                    "Ok": function () {
                        if (RedirectPath == null || RedirectPath == "") {
                            $(this).dialog("close");
                        }
                        else {
                            ajaxindicatorstart('please wait..');
                            window.location.replace(RedirectPath);
                            $(this).dialog("close");
                        }
                    }
                },
                position: { my: "center", at: "center" }//,
            });
        }//
        //end


    </script>
</head>
