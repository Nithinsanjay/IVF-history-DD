                        async: false,
                        success: function (response) {
                            if (response == "True") {

                                $('#txtNPwd').attr("disabled", false);
                                $('#txtConfirmPwd').attr("disabled", false);
                                //$("#btnClosePass").click();
                                //$('#btnPass').show();
                            }
                            else {
                                $("#btnClosePass").click();
                                $.messager.alert("Information", "Incorrect Password !");
                                //alert("Incorrect Password !");
                                $('#txtOPwd').val(""); $("#txtOPwd").css({ 'border-color': 'red' });
                            }
