        <aside class="control-sidebar control-sidebar-dark">
        </aside>
        <div id="iframe" style="display: none; width: 100%; height: 100%;"></div>
        <div class="control-sidebar-bg"></div>
    </div>
    <div id="popupAlertOverlay" class="popup-overlay" style="display: none"></div>

    <div id="popupOverlay" class="popup-overlay" style="display: none;"></div>

    <div id="RightMenuFormSlidePopup" class="DivRightMenuFormSlidePopup"></div>



     <%-- Toaster Container --%>
 <div id="ToasterContainer" class="DivToasterContainer" style="display: none"></div>
    
    <div id="PatientClinicalPopup" style="display: none;">
        <div id="pATIENTcLINICALDETAILSBody"></div>
