                  <div id="loggedInfo">
                    <%
                    string logoimgurl = OncologyEMR.DataClass.GeneralFunction.GetImageUnitWise("logo.jpg");
                    string appPath = Server.MapPath("~/");  
                    string relativeimgPath = logoimgurl.Replace(appPath, "~/").Replace("\\", "/");
                    %>
                    <%--<img src="<%=ResolveUrl("~/Images/Logo.png")%>" alt="Norway" style="margin-left:5px;width: 20%">--%>
                    <img src="<%=ResolveUrl(relativeimgPath)%>" alt="Norway" style="margin-left:5px;width: 20%">
                    <label style="color: #eb5a04;margin-left: 30px;margin-top:14px;font-size:14px"><%:Session["staffUserName"]%></label>
              </div>
                <div id="doctPanel">
                    <hr style="margin-bottom: 10px; margin-top: 0px" />

                    <div class="dropdown" style="width: 100%;">
                        <table style="width: 100%;" >
                            <tr id="SubDoctPanel">
                                <td style="width: 80%;">
                                 <form autocomplete="off"> <%--  16/12/19  --%>                                 
                                   <input type="text" id="DoctorInput" onkeyup="SearchDoctors()" placeholder="&#xF002; Search Doctor " style="height:31px;margin-left: 2%;width: 98%;border-radius: 5px; border-color: rgba(51, 122, 183, 0.55); -webkit-box-shadow: 0 8px 6px -6px black; -moz-box-shadow: 0 8px 6px -6px black; box-shadow: 0 7px 4px -6px rgb(181, 181, 181); margin-top: 2px;font-family:Arial, FontAwesome" class=" empty">
                                </form>
                              </td>
                            </tr>  
                      
                        </table>
                    </div>


                    <div class="btn-group btn-toggle1" id="divTodayYest" data-toggle="buttons" style="width: 99%; height: 26px; margin-left: 2px;position: relative;z-index: 10;"><%--priyanka 01/03/2026--%>
                        <label class="btn btn-default borderC active" style="width: 25%; font-size: 12px !important;">
                            <input type="radio" name="dateType" id="rbtnToday" value="T" autocomplete="off" checked>
                            Today
                        </label>
                        <label class="btn btn-default borderC" style="width: 30%; font-size: 12px !important;">
                            <input type="radio" name="dateType" id="rbtnYesterday" value="Y" autocomplete="off">
                            Yesterday
                        </label>
                        <label class="btn btn-default borderC" style="width: 45%; font-size: 12px !important;">
                            <input type="radio" name="dateType" id="rbtnDayBefYest" value="B" autocomplete="off">
                            Day Before
                        </label>
                    </div>

              <div class="col-md-12" style="text-align: center;">
                  <div>
                      <table id="tblDoctors" class="table" style="width: 150%; background-color: white;">
                      </table>
                  </div>
                  <input id="hdnDoctCode" type="hidden" />
              </div>
                    <div id="btnsDiv" class="btn-group btn-group-justified" style="margin-top: -15px;"></div>

                </div>
                <div id="patList">
                    <div id="DivPatGrid">
                    </div>
                   <%-- <div style="margin-top: 30px; padding: 10px; border: 1px solid #337ab7; background-color: #f9f9f9; font-family: Arial, sans-serif; font-size: 12px;">
                        <strong style="font-weight: 800; margin-right: 10px;">Note:</strong>

                        <span style="color: green; font-weight: bold; margin-right: 10px;">NW</span> - New,
                        <span style="color: green; font-weight: bold; margin-left: 10px; margin-right: 10px;">FU</span> - Follow Up,
    
                         <br>

                        <span style="color: green; font-weight: bold; margin-left: 49px;">RR</span> - Review with Report
                    </div>--%>

                </div>

                <div style="clear:both;"></div>
                <div style="margin-bottom: 10px; padding: 10px; border: 1px solid #337ab7; background-color: #f9f9f9; font-family: Arial, sans-serif; font-size: 12px;">
                    <strong style="font-weight: 800; margin-right: 10px;">Note:</strong>
                    <span style="color: green; font-weight: bold; margin-right: 10px;">NW</span> - New,
                    <span style="color: green; font-weight: bold; margin-left: 10px; margin-right: 10px;">FU</span> - Follow Up,
                    <br>
                    <span style="color: green; font-weight: bold; margin-left: 49px;">RR</span> - Review with Report
                </div>

                 <div style="display:none" id="labelForInactive"> 
                     <div class="tsStatus" style="background-color: #fd4d00 !important;"></div>
                     <label class="LBLFormat" style="margin-left:5%">Inactive Records</label>
                 </div>

<table id="tblMasterSetUplist" style="display:none;">
                     <thead><tr style="border: 1px solid black;background-color: #fafdc2;"><th style="border-right: 1px solid black;">Name</th><th>Gender</th><th style="border-left: 1px solid black;">Age</th></tr></thead>
                          <caption style="text-align:center;font-size:16px;font-weight:bold;color:black">Set up List</caption>
                            <tbody>
                             
                            </tbody>
                  </table>
            </div>
        </header>

        <!-- Content Wrapper. Contains page content -->
        <div id="secCont" class="content-wrapper">
            <div class="row">
                <div class="modal fade" id="mdAddChangePassword" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                    <div class="modal-dialog" role="document" style="width: 30%">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myCompModalLabel">Change Password</h4>
                            </div>
                            <div class="modal-body">
                                <div class="list-group">
                                    <div class="list-group-item">
                                        <input type="text" id="txtUid" class="form-control input-sm" placeholder="User ID" />
                                    </div>
                                    <div class="list-group-item">
                                        <input type="password" id="txtOPwd" class="form-control input-sm" placeholder="Current Password" />
                                    </div>
                                    <div class="list-group-item">
                                        <input type="password" id="txtNPwd" class="form-control input-sm" placeholder="New Password" />
                                    </div>
                                    <div class="list-group-item">
                                        <input type="password" id="txtConfirmPwd" class="form-control input-sm" placeholder="Confirm Password" />
                                    </div>

                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" id="btnClosePass" class="btn btn-default btn-sm" data-dismiss="modal">Close</button>
                                <button type="button" id="btnPass" class="btn btn-primary btn-sm">Save </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Header (Page header) -->
            <asp:ContentPlaceHolder runat="server" ID="Head">
            </asp:ContentPlaceHolder>


            <!-- Main content -->
            <section class="content" style="padding-bottom: 1px;width:100%"> <%--4/24/19--%>

                <asp:ContentPlaceHolder runat="server" ID="MainContent">
                </asp:ContentPlaceHolder>

            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <!-- Main Footer -->
        <%--  <div id="footerFlow" style="    position: fixed;    bottom: 0px;    left: 0;   right: 0;">
        <footer class="main-footer">
            <!-- To the right -->
