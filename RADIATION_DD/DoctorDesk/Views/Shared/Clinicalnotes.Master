    <script type="text/javascript">
        var UnitCd = '<%: Session["UNITCODE"] ?? "" %>';
        var gDoctId = '<%: Session["gOncoUserId"] ?? "" %>';
        var gDoctName = '<%: Session["gDoctName"] ?? "" %>';
        var gClinicCode = '<%: Session["CLINICCODE"] ?? "" %>';
        var gDoctCode = '<%: Session["gDoctCode"] ?? ""%>';
        var gCIMSYN = '<%: Session["CIMYN"] ?? ""%>';
        var timoutWarning = 1500000// 840000; // Display warning in 14 Mins.
        var timoutNow = 1800000 // Timeout in 30 mins.
        var logoutUrl = '../Account/Login'; // URL to logout page.
        var warningTimer;
        var timeoutTimer;
        var NotificURl = '';
        var Vaccineflag = 0;
        var userid = '<%:Session["gOncoUserId"].ToString() %>';//Somnath
        var DMSURL = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("LOCALDMSURL")%>'; //meenakshi 
        var NoteTranMode = "1";
        var QMSCall = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("QMSENABLE")%>'; //Added By RAJAN
        var DispDurCritFrPatSrchYN = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("DispDurCritFrPatSrchYN")%>'; // Added by Dhananjay 20240813
        var HideCheckPatInfoIcon = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("DispShowAllPatIcon")%>';  // Added by Dhananjay 20240828 Re
        var UNITCODE = '<%: Session["UNITCODE"] ?? "" %>';
        var adminConsoleYN = '<%: ("" + Session["CONSOLEAPPYN"]).ToString().Trim()%>';
        var FormName = "";
        var UnitSel = "";
        var isCheckingUnit = false;
