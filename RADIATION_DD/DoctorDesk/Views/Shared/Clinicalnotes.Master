        // Added by Dhananjay 20250928
        function hideButtonsOnPages(pageKeywords, elementSelectors) {
            if (!elementSelectors) {
                elementSelectors = ['#btnSave'];
            }
            var currentUrl = window.location.pathname.toLowerCase();
            var matchedKeyword = null;
            for (var i = 0; i < pageKeywords.length; i++) {
                var keyword = pageKeywords[i].toLowerCase();
                if (currentUrl.indexOf(keyword) !== -1) {
                    matchedKeyword = keyword;
                    break;
                }
            }
            if (matchedKeyword) {
                var $mainDiv = $('#ContentHolderDiv');
                $mainDiv.find('input, button, select, textarea, fieldset').prop('disabled', true);
                $mainDiv.css('pointer-events', 'none');
                for (var j = 0; j < elementSelectors.length; j++) {
                    var el = document.querySelector(elementSelectors[j]);
                    if (el) {
                        el.style.display = 'none';
                    }
                }
            }
        }
        var AdminLTEOptions = {
            enableBSToppltip: false
        };
        function ClosePatientClinicalPopup() {

            $("#PatientClinicalPopup").hide();

            $("#pATIENTcLINICALDETAILSBody").empty();

            $("#bs5css").remove();
            $("#rightMenuCss").remove();
            $("#bs5js").remove();
            $("#rightMenuJs").remove();
        }

     
        function openChemoPlanning() {

            if (CheckPatSessionNotEmpty()) {
            LoadPatientClinicalResources();
            $("#PatientClinicalPopup").show();

            $("#pATIENTcLINICALDETAILSBody").load("../SinglePage/PatientClinicalHistory", function () {

                        $("#PatientClinicalPopup .RightMenuBackIcon")
                            .removeClass("fa-chevron-right")
                            .addClass("fa-arrow-right")
                            .attr("title", "Back")
                            .off("click")
                            .on("click", function () {
                                ClosePatientClinicalPopup();
                            });

                });
            } else
                $.messager.alert("Information", "Please Select Patient");

        } 
        function toggleIconsofDivTab(e) {
            $(e.target)
                .prev('.btn-group-justified')
                .find(".moreless")
                .toggleClass('fa-plus fa-minus');
            $(document).find("[href='#" + $(e.target).attr('id') + "']")
        }


        function BtnTxtHideDisb() {
            $('#txtNPwd').attr("disabled", true);
            $('#txtConfirmPwd').attr("disabled", true);
            // $('#btnPass').hide();
        }

        function LoadPatientClinicalResources() {

            if ($("#bs5css").length == 0) {
                $("head").append(
                    '<link id="bs5css" rel="stylesheet" href="../css/Bootstrap-5.3.8/dist/css/bootstrap.css">'
                );
            }

            if ($("#rightMenuCss").length == 0) {
                $("head").append(
                    '<link id="rightMenuCss" rel="stylesheet" href="../css/RightMenu.css">'
                );
            }

            if ($("#bs5js").length == 0) {
                $("body").append(
                    '<script id="bs5js" src="../css/Bootstrap-5.3.8/dist/js/bootstrap.bundle.js"><\/script>'
                );
            }

            if ($("#rightMenuJs").length == 0) {
                $("body").append(
                    '<script id="rightMenuJs" src="../Scripts/SinglePage/RightMenuSlide.js"><\/script>'
                );
            }
        }
        function SaveAction() {
            if (Validation() == false || ConfirmPassWord() == false) {
                return false;
            }
            else {
                uid = $('#txtUid').val();
                Npwd = $('#txtNPwd').val();
                Cpwd = $('#txtConfirmPwd').val();
                var datatosend = { uid: uid, Npwd: Npwd, Cpwd: Cpwd }
                // ajaxindicatorstart('Saving data.. please wait..');

                $.ajax({
                    type: "POST",
                    url: '../DoctorDesk/ChangePWD',
                    data: datatosend,
                    dataType: "json",
                    cache: false,
                    success: function (response) {
                        $("#btnClosePass").click();
                        $.messager.alert("Information", response);
                        //ajaxindicatorstop();
                        ClearTxtbx();
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        // ajaxindicatorstop();
                        $.messager.alert(textStatus, "Error Information");
                    }
                })
            }
        }

        function ClearTxtbx() {
            $('#txtOPwd').val("");
            $('#txtNPwd').val("");
            $('#txtConfirmPwd').val("");
        }

        function GetPatNotes(strTranNo, strMrNo) {
            $.ajax({
                url: '../DoctorDesk/GetPatNotes',
                data: { strTranNo: strTranNo, strMrNo: strMrNo },
                datatype: 'json',
                type: 'post',
                success: function (response) {

                    $(document).ready(function () {

                        if (response === "") {
                            $("#tblNotesList").empty();
                        }
                        else if (response != "") {
                            $("#tblNotesList").empty();
                            $.each(response, function (i, val) {
                                var type = (response[i].NOTETYPE) == "R" ? "Private" : "Share";
                                var color = (response[i].NOTETYPE) == "P" ? "#f4e1ef" : "";//13th nov 
                                var id = (response[i].CODE);//13th nov
                                var tr = "<tr id='" + id + "' style='background-color:" + color + "' ><td id='" + id + "_" + (response[i].NOTETYPE) + "'>" + response[i].NOTE + "</td></tr>";//13th nov
                                $("#tblNotesList").append(tr);
                            });
                        }
                    });

                    filterRowsByNoteType();//priyanka 28/02/2026
                },
                error: function () {
                    
                }
            });
        }

        function ConfirmPassWord() {
            var a = $("#txtNPwd").val();
            var b = $("#txtConfirmPwd").val();
            if (a === b) {
                return true;
            }
            else {
                $("#btnClosePass").click();
                $.messager.alert("Information", "Password does not match!");
                $('#txtConfirmPwd').val("");
                return false;
            }
        }

        function Makenormal() {
            if (("" + $("#txtUid").val()).trim().length != 0) {
                $("#txtUid").css({ 'border-color': '' });
            }
            if (("" + $("#txtOPwd").val()).trim().length != 0) {
                $("#txtOPwd").css({ 'border-color': '' });
            }
            if (("" + $("#txtNPwd").val()).trim().length != 0) {
                $("#txtNPwd").css({ 'border-color': '' });
            }
            if (("" + $("#txtConfirmPwd").val()).trim().length != 0) {
                $("#txtConfirmPwd").css({ 'border-color': '' });
            }
        }

        function RemoveBorder() {
            if ($("#txtUid").val() == "") {
                $("#txtUid").css({ 'border-color': '' });
            }
            if ($("#txtOPwd").val() == "") {
                $("#txtOPwd").css({ 'border-color': '' });
            }
            if ($("#txtNPwd").val() == "") {
                $("#txtNPwd").css({ 'border-color': '' });
            }
            if ($("#txtConfirmPwd").val() == "") {
                $("#txtConfirmPwd").css({ 'border-color': '' });
            }
        }

        function Validation() {
            var i = 0;
            if (("" + $("#txtUid").val()).trim().length == 0) {
                $("#txtUid").focus();
                $("#txtUid").css({ 'border-color': 'red' });
                i = 1;
            }
            else {
                $("#txtUid").css({ 'border-color': '' });

            }
            if (("" + $("#txtOPwd").val()).trim().length == 0) {
                //$("#txtOPwd").focus();
                $("#txtOPwd").css({ 'border-color': 'red' });
                i = 1;
            }
            else {
                $("#txtOPwd").css({ 'border-color': '' });


                if (("" + $("#txtNPwd").val()).trim().length == 0) {
                    $("#txtNPwd").focus();
                    $("#txtNPwd").css({ 'border-color': 'red' });
                    i = 1;
                }
                else {
                    $("#txtNPwd").css({ 'border-color': '' });

                }
                if (("" + $("#txtConfirmPwd").val()).trim().length == 0) {
                    $("#txtConfirmPwd").focus();
                    $("#txtConfirmPwd").css({ 'border-color': 'red' });
                    i = 1;
                }
                else {
                    $("#txtConfirmPwd").css({ 'border-color': '' });

                }
            }

            if (i == 1) {
                return false;
            }
            else {
                return true;
            }
        }


        // define a handler added by vijeta on 7th april 2018
        function doc_keyUpForRightLst(e) {

            if (e.altKey && e.keyCode == 72) { //H
                $('#lishistory').trigger("click");// History from right side list
            }
            else if (e.altKey && e.keyCode == 84) { //T
                $("#lisVitalHistory").trigger("click");//Vital History from right side list
            }
            else if (e.altKey && e.keyCode == 78) { //N
                $("#lisattach").trigger("click");// History from right side list
            }
            else if (e.altKey && e.keyCode == 90) {
                $("#lisDocuments").trigger("click");
            }
        }

        //end
        function SetRightMenuOptionFocus() {
            var page = window.location.href;
            if (page.indexOf("Vaccination") != -1) {
               $("li#lisVaccination").addClass("RightMenuSelectedOption");
               $("li#lisVaccination img").attr("src", "../Images/vaccineNewBlue.png");
            }
        }



        // Display Count - Added by Dhananjay - 20240703  
        function SetCountsForHistory(strMrNo) {
            if (strMrNo != undefined) { 
                $.get("../DoctorDesk/GetAllHistoryCounts", { strMrNo: strMrNo }, function (data) {

                    // Vital History
                    if (data.vitalHistoryCount != "0")
                        $("#lblVitalHisCnt").text(data.vitalHistoryCount);
                        $("#lblVitalHisCnt").css({
                          'float': 'right',
                          'margin-right': '10px',
                          'color': 'brown'
                        });

                    // History
                    if (data.HistoryCnt != "0") {
                        $("#lblHistoryCnt").text(data.HistoryCnt);
                        $("#lblHistoryCnt").css({
                            'float': 'right',
                            'margin-right': '10px', 
                            'color': 'brown'
                        });
                    } else {
                        $("#historyPanel").css('display', 'none');
                    }

                    // Clical History
                    if (data.medicationHisCount != "0") {
                        $("#lblClinicalHisCnt").text(data.medicationHisCount);
                        $("#lblClinicalHisCnt").css({
                            'float': 'right',
                            'margin-right': '10px',
                            'color': 'brown'
                        });
                    } else {
                        $("#historyPanel").css('display', 'none');
                    }

                    // vaccination
                    if (data.VaccineCount != "0")
                        $("#lblVaccinationCnt").text(data.VaccineCount);
                        $("#lblVaccinationCnt").css({
                          'float': 'right',
                          'margin-right': '10px',
                          'color': 'brown'
                       });

                });
            }
        }

        function OpenUnitSel() {
            var curFormURL = ("" + '<%= Request.Url.AbsolutePath %>').toString().toUpperCase().trim();
            var loadedFormName = curFormURL.substr(curFormURL.lastIndexOf("/") + 1);
            if (loadedFormName.toUpperCase() == "CLINICENTRY" && '<%:Session["SINGLEUNITYN"]%>' == "N") {
                $("a#btnHospUnitDiv").click();
            }
        }

        function Signout() {
            sessionStorage.clear();
            if (RedirectToHMIS === "Y") {
                GoToHome("Login");
            }
            else {
                window.location.href = "../Account/Login";
            }
        }

        function SignoutConfirm() {
            sessionStorage.clear();
            if (RedirectToDD === "Y") {
                window.location.href = "../Account/Login";
            }
            else {
                GoToHome("Login");
            }
            //openPopupDynamic("Signout", "Do You Want to Signout ?", [
            //    { text: "Logout", class: "btn btn-yes", action: "Signout()" },
            //    { text: "Cancel", class: "btn btn-no", action: "closePopup()" }

            //]);
        }

        function GoToHome(FormName) {
            var curURL = ("" + '<%= Request.UrlReferrer %>').toString().toUpperCase().trim();
            var splitURL = curURL.split('/');
            var HTTPorHTTPS = curURL.toUpperCase().includes("HTTPS") ? "https" : "http";
            if (curURL.indexOf("TESTWEBHMIS") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/TestWebHmis/Account/" + FormName;
            }
            else if (curURL.indexOf("WEBHMIS") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/" + FormName;
            }
            else if (curURL.indexOf("TESTOTCATH") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/TestWebHmis/Account/" + FormName;
            }
            else if (curURL.indexOf("WEBOTCATH") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/" + FormName;
            }
            else if (curURL.indexOf("HMIS") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/HMIS/Account/" + FormName;
            }
            else if (curURL.indexOf("WEBEHR") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/" + FormName;
            }
        }
    </script>

    <%--Priyanka 28/02/2026--%>
    <script>
        $(document).ready(function () {
            debugger;
            /*GetPatNotes(sessionStorage.getItem("PatTRANNO"), sessionStorage.getItem('PatMRNO'));*/

            $("input[name='NoteType']").on('change', function () {
                filterRowsByNoteType();
            });
        });

        function filterRowsByNoteType() {
            var selectedVal = $("input[name='NoteType']:checked").val();

            $("#tblNotesList tr").each(function () {
                var bgColor = $(this).css("background-color");

                function rgbToHex(rgb) {
                    var result = /^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/.exec(rgb);
                    return result ? "#" +
                        ("0" + parseInt(result[1], 10).toString(16)).slice(-2) +
                        ("0" + parseInt(result[2], 10).toString(16)).slice(-2) +
                        ("0" + parseInt(result[3], 10).toString(16)).slice(-2) : rgb;
                }

                var hexColor = rgbToHex(bgColor).toLowerCase();

                if (selectedVal === "P") {
                    // Show only rows with background color #f4e1ef
                    if (hexColor === "#f4e1ef") {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                } else if (selectedVal === "R") {
                    // Show only rows without background color (i.e., empty string or transparent)
                    if (hexColor === "#f4e1ef" || hexColor === "transparent") {
                        if (hexColor === "#f4e1ef") {
                            $(this).hide();
                        } else {
                            $(this).show();
                        }
                    } else {
                        $(this).show();
                    }
                } else {
                    // If other, show all rows (optional)
                    $(this).show();
                }
            });
        }
        filterRowsByNoteType();
    </script>
