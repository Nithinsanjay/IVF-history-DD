      #PatientClinicalPopup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: white;
    z-index: 1040;
    overflow: auto;
}

      #PatientClinicalOverlay{
    position:fixed;
    left:0;
    top:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,.45);
    z-index:99998;
}

#PatientClinicalContainer{
    position:fixed;
    left:0;
    top:0;
    width:100vw;
    height:100vh;
    background:#fff;
    z-index:99999;
    display:flex;
    flex-direction:column;
}

#PatientClinicalHeader{
    height:50px;
    background:#2d6ca2;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 15px;
    font-size:18px;
    font-weight:bold;
}

#btnCloseClinicalPopup{
    border:none;
    background:transparent;
    color:white;
    font-size:22px;
    cursor:pointer;
}

#PatientClinicalBody{
    flex:1;
    overflow:auto;
    background:white;
}
    
#PatientClinicalPopup .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}
      /*------------start-----added in all masters------ Meenakshi to apply a slim scroll ---------*/
        ::-webkit-scrollbar {
    width: 6px;
      height:6px;
}
 
::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3); 
    border-radius: 10px;
}
 
::-webkit-scrollbar-thumb {
    border-radius: 10px;
    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.5); 
    background: rgba(255,0,0,0.8);
}

 /*------------end----------- Meenakshi to apply a slim scroll ---------*/

        .navbar-nav > .user-menu > .dropdown-menu {
            /*width: 450px;*/
        }

        #lnkNewNotes:hover, #lnkAddComp:hover {
            cursor: pointer !important;
        }

        .dropbtn {
            background-color: transparent;
            color: black;
            padding: 5px;
            font-size: 12px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            outline: 0;
        }

        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 140px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
        }

            .dropdown-content a {
                color: black;
                padding: 3px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                }

        .dropdown:hover .dropdown-content {
            display: block;
            height: 35px;
        }

        .dropdown:hover .dropbtn {
        }

        .sdList {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1; /* Sit on top */
            right: 0;
            top: 0;
            width: 35%; /* Full width */
            height: 20%; /* Full height */
            overflow: auto; /* Enable scroll if needed */
            background-color: rgb(0,0,0); /* Fallback color */
            background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
            -webkit-animation-name: fadeIn; /* Fade in the background */
            -webkit-animation-duration: 0.4s;
            animation-name: fadeIn;
            animation-duration: 0.4s;
            margin-top: 35px;
        }

        .modal {
            display: none; /* Hidden by default */
            position: fixed; /* Stay in place */
            z-index: 1; /* Sit on top */
            left: 0;
            top: 0;
            width: 85%; /* Full width */
            /*height: 100%;*/ /* Full height */
            height:auto;
            overflow: auto; /* Enable scroll if needed */
            background-color: rgb(0,0,0); /* Fallback color */
            background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
            -webkit-animation-name: fadeIn; /* Fade in the background */
            -webkit-animation-duration: 0.4s;
            animation-name: fadeIn;
            animation-duration: 0.4s;
        }

        /* Modal Content */
        .modal-content {
            position: fixed;
            bottom: 0;
            background-color: #fefefe;
            width: 230px;
            -webkit-animation-name: slideIn;
            -webkit-animation-duration: 0.4s;
            animation-name: slideIn;
            animation-duration: 0.4s;
        }

