                  /*4/11/19*/    
.HeadPatTab { min-width: 100%; }

.HeadPatTab > thead,
.HeadPatTab > tbody >tr{
/*thead, tbody tr {*/
    display: table;
    width: 100%;
    table-layout: fixed;
}
.HeadPatTab > tbody{
    display: block;
    max-height: 500px;
    overflow-x: hidden;
    overflow-y: scroll;
}

.HeadPatTab > tbody > tr > td {
    overflow: hidden;
    text-overflow: ellipsis;
}
.HeadPatTab > thead > tr > th{
    text-align:center;
    border: 1px solid #ede4e4;
      height: 22px;
      font-size:12px;
}

/*thead th {
    height: 22px;
    text-align: left;
}*/
.HeadPatTab > thead > tr,
.HeadPatTab > tbody > tr
{
    width:100%;
}
        @media (min-width: 1400px) {
            .HeadPatTab  { min-width: 600px; }
            .HeadPatTab > tbody {
    display: block;
    max-height: 600px;
    overflow-x: hidden;
    overflow-y: scroll;
}

        }
