            $(document).on('click', '.patNameCls', function () {
                var group = $(this).attr('data-group');
                var btn = $(".btn-save-patstatus");

                // Reset state
                $("#MainDiv").hide();
                btn.parent().hide(); // Hide button container by default

                //GetAllCounts();//priyanka 12/03/2026

                if (group === "NotArrived") {
                    // 1. Not Arrived: Hide MainDiv, Show "Mark as Arrive", set type "A"
                    $("#MainDiv").hide();
                    btn.text("Mark as arrived");
                    btn.attr("onclick", "SavePatientArrival('A')");
                    btn.parent().show();
                }
                else if (group === "Arrived") {
                    // 2. Arrived: Show MainDiv, Show "Post to Consultant", set type "P"
                    $("#MainDiv").show();
                    btn.text("Post to Consultant");
                    if (isVitalsCompleted.trim() === "Y") {
                        btn.attr("onclick", "SavePatientArrival('P')");
                    }
                    else {
                        //btn.attr("onclick", /*"SavePatientArrival('P')"*/);  // SavePatientArrival Comment By Abhishesh
                        btn.removeAttr("onclick");
                        if (showVitalsAlert == "Y") {
                            btn.attr("onclick", "ValidationForPostConslt()");
                        }
                        else {
                            btn.attr("onclick", "SavePatientArrival('P')");
                        }
                    }
                    /*btn.attr("onclick", *//*"SavePatientArrival('P')"*//*);  // SavePatientArrival Comment By Abhishesh*/
                   
                    btn.parent().show();
                }
                else {
                    // 3. Waiting or Completed: Hide button, Show MainDiv
                    $("#MainDiv").show();
                    btn.parent().hide();
                }
            });

        });
