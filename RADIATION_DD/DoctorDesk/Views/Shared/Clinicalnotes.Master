                  /*/................. 10-12-19 for Back Button.....................*/

strong {
	 font-weight: bold;
}
 .button1 {
    background-color: rgba(242, 242, 242, 1);
    background-image: linear-gradient(to bottom, rgba(242, 242, 242, 1), rgba(242, 242, 242, 1));
    border: 1px solid rgba(191, 191, 191, 1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 1), inset 0 -1px 0 rgba(217, 217, 217, 1), inset 0 0 0 1px rgba(242, 242, 242, 1), 0 2px 4px rgba(0, 0, 0, 0.2);
    color: rgba(140, 140, 140, 1);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
    border-radius: 11px;
    cursor: pointer;
    display: inline-block;
    font-family: Verdana, sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 20px;
   padding:3px 15px 2px 15px;
    /*margin: 16px 0 0 16px;*/
    transition: all 20ms ease-out;
    vertical-align: top;
}
 .button1:hover, .button1:focus {
	 background: rgba(242, 242, 242, 1);
	 border-color: rgba(140, 140, 140, 1);
	 box-shadow: inset 0 1px 0 rgba(255, 255, 255, 1), inset 0 -1px 0 rgba(217, 217, 217, 1), inset 0 0 0 1px rgba(242, 242, 242, 1);
}
 .button1:active {
	 background: rgba(242, 242, 242, 1);
	 box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.2);
}
 .button1 .fa {
	 color: rgba(191, 191, 191, 1);
	 text-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
}
 
.button1-green {
    background-color: rgb(57, 142, 190);
   background-image: linear-gradient(to bottom, rgb(86, 135, 162), rgb(118, 185, 222));
    border: 1px solid rgb(57, 142, 190);
    box-shadow: inset 0 1px 0 rgb(52, 123, 165), inset 0 -1px 0 rgb(51, 127, 171), inset 0 0 0 1px rgb(48, 124, 167), 0 2px 4px rgba(0, 0, 0, 0.2);
    color: #fdf9f9;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}
 .button1-green:hover, .button1-green:focus {
	 background: rgb(57, 142, 190);
	 border-color: rgba(50, 102, 18, 1);
	 box-shadow: inset 0 1px 0 rgba(198, 230, 179, 1), inset 0 -1px 0 rgba(121, 179, 86, 1), inset 0 0 0 1px rgba(0, 0, 0, 1);
}


     
 .button1-green:active {
	 background: rgb(57, 142, 190);
	 box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.2);
}
 .button1-green .fa {
     color: rgb(78, 78, 78);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
}


 /*//...........................*/
