        function GoToHome() {
            var curURL = ("" + '<%= Request.UrlReferrer %>').toString().toUpperCase().trim();
            var splitURL = curURL.split('/');
            var HTTPorHTTPS = curURL.toUpperCase().includes("HTTPS") ? "https" : "http";
            if (curURL.indexOf("TESTWEBHMIS") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/TestWebHmis/Account/ModuleList";
            }
            else if (curURL.indexOf("WEBHMIS") != -1) {
                window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/ModuleList";
            }
            else if (curURL.indexOf("TESTOTCATH") != -1) {
                 window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/TestWebHmis/Account/ModuleList";
            }
            else if (curURL.indexOf("WEBOTCATH") != -1) {
                 window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/ModuleList";
            }
            else if (curURL.indexOf("HMIS") != -1) {
                 window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/HMIS/Account/ModuleList";
            }
            else if (curURL.indexOf("WEBEHR") != -1) {
                 window.location.href = HTTPorHTTPS + "://" + splitURL[2] + "/WebHmis/Account/ModuleList";
            }
        }

        // Added by Dhananjay 20250928
        function hideButtonsOnPages(pageKeywords, elementSelectors) {
            if (!elementSelectors) {
                elementSelectors = ['#btnSave', '#PrevHistoryBtn'];
            }

            var currentUrl = window.location.pathname.toLowerCase();
            var matchedKeyword = null;

            // Find which keyword matches current URL
            for (var i = 0; i < pageKeywords.length; i++) {
                var keyword = pageKeywords[i].toLowerCase();
                if (currentUrl.indexOf(keyword) !== -1) {
                    matchedKeyword = keyword;
                    break;
                }
            }

            if (matchedKeyword) {
                // If we're NOT on Diagnosis page, disable #MainDiv
                if (matchedKeyword !== 'diagnosis') {
                    var $mainDiv = $('#MainDiv');
                    $mainDiv.find('input, button, select, textarea, fieldset').prop('disabled', true);
                    $mainDiv.css('pointer-events', 'none');
                } else {
                    if (matchedKeyword == "diagnosis") {
                        $('#ContentHolderDiv').find(':not(.nav-tabs-custom)').each(function () {
                            if ($(this).is('input, button, select, textarea, fieldset')) {
                                $(this).prop('disabled', true);
                            }
                            $(this).css('pointer-events', 'none');
                        });
                        $("#Diagno, #ICDDiag, #ICDDiagO,#ICDOHist_LI").closest("li").css("pointer-events", "auto").find("a").css("pointer-events", "auto");
                        $("#ICDOHist_LI,#ICDOHistory").css("pointer-events", "auto").prop("disabled", false);
                    }
                }

                for (var j = 0; j < elementSelectors.length; j++) {
                    var el = document.querySelector(elementSelectors[j]);
                    if (el) {
                        el.style.display = 'none';
                    }
                }
            }
        }

