            //-------------------------------------

            //added on 2nd may 2018
            $("#btnSaveNotes").click(function () {
                ////debugger;
                var strTranno = $.session.get('PatTRANNO');
                // Meenakshi 
                if (strTranno == undefined) { strTranno = ""; }
                var strMrNo = $.session.get('PatMRNO');
                var strNotes = $("#txtNotes").val();
                var strNoteType = $("input[name='NoteType']:checked")[0].value;
                var strNoteCode = "";

                if ($("#showNotesDiv tr td.NoteTrActive").length > 0) {
                    strNoteCode = $("#showNotesDiv tr td.NoteTrActive").closest("tr")[0].id;
                    NoteTranMode = "2";//for edit vijeta 18/4/19
                }

                if (typeof patCompletedYN1 === "undefined" || patCompletedYN1 === null) {
                    $.messager.alert("Alert", "Please Select Patient");// 27-11-19 -heading chngd
                }
                else if (strNotes == "") {
                    $.messager.alert("Information", "Please Enter Notes");
                }
                else {
                    if (strMrNo != "" && strMrNo != undefined && strMrNo != null) {
                        $.ajax({
                            url: '../DoctorDesk/SaveNotes',
                            data: { strNotes: strNotes, strTranNo: strTranno, strMrNo: strMrNo, strNoteType: strNoteType, strNoteCode: strNoteCode, tranMode: NoteTranMode },// tranModevijeta 18/4/19
                            datatype: 'json',
                            type: 'post',
                            success: function (result) {
                                //added on 12th may 2018
                                if ($("#btnSaveNotes").text().indexOf("Update") != -1) {
                                    $.messager.alert("Information", "Notes updated successfully");
                                    $("#btnSaveNotes").text("Save");
                                    $("#rbtnPrivate").prop("checked", "checked");//by vijeta 18/4/19
                                }
                                else if ($("#btnSaveNotes").text().indexOf("Save") != -1) {
                                    $.messager.alert("Information", "Notes saved successfully");
                                    //$("#btnSaveNotes").text("Update Notes");
                                }
                                else
                                    $.messager.alert("Information", result);

                                // $.messager.alert("Information", result);

                                if (("" + result).toUpperCase().indexOf("SUCCESSFUL") != -1) {
                                    $("#txtNotes").val('');
                                    GetPatNotes(strTranno, strMrNo);
                                }

                            },
                            error: function () {

                            }
                        });

                    }
                }
            });

