        // define a handler added by vijeta on 7th april 2018
        function doc_keyUpForRightLst(e) {

            if (e.altKey && e.keyCode == 72) { //H
                $('#lishistory').trigger("click");// History from right side list
            }
            else if (e.altKey && e.keyCode == 84) { //T
                $("#lisVitalHistory").trigger("click");//Vital History from right side list
            }
            else if (e.altKey && e.keyCode == 78) { //N
                $("#lisNotes").trigger("click");// History from right side list//kavita linkname
            }
                //added by kavita 14-8-18
            else if (e.altKey && e.keyCode == 89) {
                $("#lisMedicationHistory").trigger("click");
            }
            else if (e.altKey && e.keyCode == 71) {
                $("#lisAllergy").trigger("click");
            }
            else if (e.altKey && e.keyCode == 66) {
                $("#lisSPTFormat").trigger("click");
            }

                //ended by kavita 14-8-18

                //added by kavita 17-8-18
            else if (e.altKey && e.keyCode == 87) {
                $("#lisattach").trigger("click");
            }
            else if (e.altKey && e.keyCode == 90) {
                $("#lisDocuments").trigger("click");
            }
                //else if (e.altKey && e.keyCode == 76) {  //added by vishal
                //    $("#lisMasterUpdt").trigger("click");
                //}
            else if (e.altKey && e.keyCode == 81) {// chngd keycode
                $("#lisMasterUpdt").trigger("click");
            }

        }

        function GetPatNotes(strTranNo, strMrNo) {
            $.ajax({
                url: '../DoctorDesk/GetPatNotes',
                data: { strTranNo: strTranNo, strMrNo: strMrNo },
                datatype: 'json',
                type: 'post',
                async:true,  //Added By meenakshi to make the page load fast because of slowness
                success: function (response) {
                    $(document).ready(function () {
                        if (response != "") {
                            $("#tblNotesList").empty();
                            $.each(response, function (i, val) {
                                var type = (response[i].NOTETYPE) == "R" ? "Private" : "Share";
                                var color = (response[i].NOTETYPE) == "P" ? "#f4e1ef" : "";//13th nov 
                                var id = (response[i].CODE);//13th nov
                                var tr = "<tr id='" + id + "' style='background-color:" + color + "' ><td id='" + id + "_" + (response[i].NOTETYPE) + "'>" + response[i].NOTE + "</td></tr>";//13th nov
                                $("#tblNotesList").append(tr); 
                            });
                        }
                    });
                },
                error: function () {

                }
            });
        }

        function SetCountsForHistory(strMrNo) {
            if (strMrNo != undefined && strMrNo != null && strMrNo != "") {  //Added this condition meenakshi on 20/01/2022
                $.ajax({
                    type: "POST",
                    url: "../DoctorDesk/GetAllHistoryCounts",
                    <%-- url: "<%=Url.Action("GetMasterSetUpList","Clinicalnotes")%>",--%>
                    data: { strMrNo: strMrNo },
                    asycn: true,
                    success: function (data) {
                        //Notes
                        if (data.notesCount != "0")
                            $("#lblNotesCnt").text(data.notesCount);

                        //Vital History
                        if (data.vitalHistoryCount != "0")
                            $("#lblVitalHisCnt").text(data.vitalHistoryCount);

                        //Medication History
                        if (data.medicationHisCount != "0")
                            $("#lblMedicationHisCnt").text(data.medicationHisCount);

                        //History
                        if (data.HistoryCnt != "0") {
                            $("#lblHistoryCnt").text(data.HistoryCnt);
                            $("#historyPanel").css('display', 'inline-block');
                            //if ($(location).attr("href") == "http://localhost:49495/DoctorDesk/PatientEntry")
                            //    $("#historyPanel").trigger("click");//
                            $("#panHisCnt").text(data.HistoryCnt);
                            //PatHistoryTab();
                        } else {
                            $("#historyPanel").css('display', 'none');
                        }
                        //vaccination
                        if (data.VaccineCount != "0")
                            $("#lblVaccinationCnt").text(data.VaccineCount);

                        if (data.InvestNotifCode != "" && $("#lblInvNotiCD") != undefined) {
                            $("#lblInvNotiCD").text('CODE : ' + data.InvestNotifCode);
                            $("#lblInvNotiCD").show();
                        }
                        else
                            $("#lblInvNotiCD").hide();

                        if (data.InvestNotifCode != "" && $("#LblInvstNotifi") != undefined) {
                            $("#LblInvstNotifi").text('CODE : ' + data.InvestNotifCode);
                            $("#SpanInvstNotifi").show();
                        }
                        else {
                            $("#LblInvstNotifi").hide();
                            $("#SpanInvstNotifi").hide();
                        }

                        //Attachment Count
                        if (data.attachmentCount != "0")//Added By Priyanka on 07/02/2025
                        {
                            $("#lblAttachmentCount").text(data.attachmentCount);
                        }
                        if (data.tumorDetails != "0") {
                            $('#TumorPanel').show();
                            $('#panTumorCnt').text(data.tumorDetails);

                        }
                        else
                            $('#TumorPanel').hide();
                    }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                        HoldOn.close();//
                        $.messager.alert("Error", errorThrown);
                    },
                    complete: function () {
                        HoldOn.close();//
                    }
                });
            }
        }
        function GetSurgicalCount(strMrNo) {
            if (strMrNo != undefined && strMrNo != null && strMrNo != "") {
                $.ajax({
                    type: "POST",
                    url: "../DoctorDesk/GetSurgicalHistoryData",
                    data: { strMrNo: strMrNo },
                    asycn: true,
                    success: function (data) {
                        //SurgicalCount
                        var recordCount = data.length;
                        if (recordCount != "0")
                            $("#lblSurgicalHisCnt").text(recordCount);

                    }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                        HoldOn.close();
                        $.messager.alert("Error", errorThrown);
                    },
                    complete: function () {
                        HoldOn.close();
                    }
                });
            }
        }

        function SetRightMenuOptionFocus() {
            var page = window.location.href;
            if (page.indexOf("VitalHistory") != -1) {
                $("li#lisVitalHistory").addClass("RightMenuSelectedOption");
                $("li#lisVitalHistory img").attr("src", "../Images/bpColor.png");
            }

            else if (page.indexOf("MedicationHistory") != -1) {
                $("li#lisMedicationHistory").addClass("RightMenuSelectedOption");
                $("li#lisMedicationHistory img").attr("src", "../Images/formColor.png");
            }

            else if (page.indexOf("Notes") != -1) {
                $("li#lisNotes").addClass("RightMenuSelectedOption");
                $("li#lisNotes img").attr("src", "../Images/writingColor.png");
            }

            else if (page.indexOf("Allergy") != -1) {
                $("li#lisAllergy").addClass("RightMenuSelectedOption");
                $("li#lisAllergy img").attr("src", "../Images/AllergyColor.png");
            }

            else if (page.indexOf("SPTReporting") != -1) {
                $("li#lisSPTFormat").addClass("RightMenuSelectedOption");
                $("li#lisSPTFormat img").attr("src", "../Images/DiagramColor.png");
            }

            else if (page.indexOf("Attachments") != -1) {
                $("li#lisattach").addClass("RightMenuSelectedOption");
                $("li#lisattach img").attr("src", "../Images/AttachmentColor.png");
            }

            else if (page.indexOf("History") != -1) {
                $("li#lishistory").addClass("RightMenuSelectedOption");
                $("li#lishistory img").attr("src", "../Images/historyColor.png");
            }
            else if (page.indexOf("LanguageEntry") != -1) {//

                $("li#lisMasterUpdt").addClass("RightMenuSelectedOption");
                $("li#lisMasterUpdt img").attr("src", "../Images/settingscolor.png");

            }

        }
        function GetWholeSetupList() {//

            $.confirm({
                title: 'Master Set Ups',
                theme: 'supervan',
                // theme: 'material',
                closeIcon: true,
                offsetTop: 10,
                type: 'orange',
                backgroundDismissAnimation: 'glow',
                //  columnClass: 'col-md-6',
                content: '' +
                    //<td style="width:6%"><label style="background-color: transparent; border-color: transparent;margin-left:0px" class="form-control" id="investigationSetUpAdd"> <img src="../Images/add.png"  style=" background-color: white;   border-radius: 50%;position:fixed; "></label></td>
                 '<form action="" class="formName"><div class="form-group"><table style="width:100%"><tr><td><input id="txtInvestigation" type="text" id="input-name" placeholder="Search Setup" class="form-control" onkeyup="SearchInvestigations()" style="" autofocus></td></tr></table></div>' +
                '<div id="divtblInvestigation" class="divtblInvestigation" style=""><table id="tblPersInvestigationlist" style="width:100%;border-top:1px solid #29884bd6 !important;" class="table"><tbody></tbody></table></div>' +
                '</form>',
                buttons: {
                    formSubmit: {
                        text: '<i class="fa fa-check-circle-o"></i>',
                        btnClass: 'btn-default',
                        action: function () {
                            if (($.session.get('PatTRANNO')) != undefined && ($.session.get('PatTRANNO')) != null) {
                                if ($.session.get('PatCompleted') != "Y") {
                                    stringcode = '';
                                    var row = $('#tblPersInvestigationlist tr')
                                    for (r = 0; r < row.length; r++) {
                                        var Chk = $(row[r]).find('.chkPersDis')
                                        if (Chk[0].checked) {
                                            //CodeTosend.push($(row[r]).attr('id'));
                                            stringcode += "'" + $(row[r]).attr('id') + "'" + ','
                                            // stringcode +=  $(row[r]).attr('id') +  ','
                                        }
                                    }
                                    var codeT = stringcode.slice(1)
                                    var strCode = codeT.substr(0, codeT.length - 2);
                                    SavePersMastrSetUp(strCode);
                                }
                                else {
                                    $.alert('Can not apply set up.Patient is completed');
                                }
                            }
                            else {
                                $.alert('Please Select Patient');
                            }
                        }
                    },
                    Closeed: {
                        text: '<i class="fa fa-close "></i>'
                        //close
                    }
                },

                onOpen: function () {
                    $('jconfirm-box').css('margin-top', '10px !important;')
                },
                onContentReady: function () {
                    // GetpersonalisedList()
                    GetpersonalWholeSetUpList();
                    $('.jconfirm-buttons').addClass('JsBtnPostion')
                    var defaultbtn = $('.jconfirm-buttons>button');
                    $.each(defaultbtn, function (index, val) {
                        $(defaultbtn[index]).css('font-size', '35px');
                        $(defaultbtn[index]).css('margin-right', '10px');
                    })
                    $(defaultbtn[0]).attr('id', 'btnSubmit');
                    $(defaultbtn[0]).addClass('disable-clicks');

                    $('.jc-bs3-row').removeClass('row')
                    $('.jconfirm-box-container').removeClass('col-xs-offset-1')
                    $('.jconfirm-box-container').removeClass('col-xs-10');
                    $('.jconfirm-box-container').removeClass('col-md-4');
                    var jc = this;
                    this.$content.find('form').on('submit', function (e) {
                        e.preventDefault();
                        jc.$$formSubmit.trigger('click'); // reference the button and click it
                    });

                    $('.jconfirm-bg').css('background-color', 'rgba(255, 255, 255, 0.62)');
                    $('.jconfirm-box').css('background-color', 'rgba(43, 43, 60, 0.98)');
                    $('.jconfirm-box').css('box-shadow', '#868686 0px -1px 14px 4px');

                }
            });

        }

        function GetpersonalWholeSetUpList() {//
            var strAge = ($.session.get('PatAge2') == undefined || $.session.get('PatAge2') == null) ? "" : $.session.get('PatAge2').toString();

            HoldOn.open();//
            $.ajax({
                type: "POST",
                url: "../Clinicalnotes/GetMasterSetUpList",
               <%-- url: "<%=Url.Action("GetMasterSetUpList","Clinicalnotes")%>",--%>
                data: { strAge: strAge, strCimsYN: '<%:Session["CIMYN"]%>', strGender: $.session.get('PatGender') },//
                asycn: true,
                success: function (response) {
                    if (response != "" && response.toUpperCase() != "UNSUCCESSFULL") {//added vijeta 26/4/19
                        var result = JSON.parse(response)
                        var rows = "";
                        for (i = 0; i < result.Table1.length; i++) {

                            if (result.Table1[i].STATUS != "I") //added only active set ups
                            {
                                rows += "<tr id='" + $.trim(result.Table1[i].CODE) + "'>" + "<td style='width:40px !important'><input class='chkPersDis' type='checkbox' style='margin-left:10px;height:20px;width:20px' onchange='handleChange(this);'></td><td class='InvestigationName' style='padding:5px;font-size: 13px;vertical-align:middle;width:70%' ><b>" + $.trim(result.Table1[i].NAME) + "</b></td>"
                               + "<td style='font-size:13px;width:15%;vertical-align:middle;'>" + result.Table1[i].GENDER + "</td><td style='font-size:13px;width:15%;vertical-align:middle;'>" + result.Table1[i].FROMAGE + " - " + result.Table1[i].TOAGE + "</td>";
                                rows += "</tr>";
                            }
                        }
                        $('#tblPersInvestigationlist tbody').empty();// added by vijeta on 2nd may 2018
                        $('#tblPersInvestigationlist tbody').append(rows).closest('tr');
                    }
                }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                    HoldOn.close();//
                    $.messager.alert("Error", errorThrown);
                },
                complete: function () {
                    HoldOn.close();//
                },
            });
        }

        function handleChange(obj) {//
            var parentRow = $(obj).parent().parent();
            $('#tblPersInvestigationlist tbody').prepend(parentRow).closest('tr');
            $('table tr:nth-child(1)').find('input:first').focus(); // added by vijeta on 7th july 2018
            CountCheckBoxChecked();
        }

        function CountCheckBoxChecked() {//
            var CheckBoxCount = $('.chkPersDis:checked').size();
            if (CheckBoxCount > 0) {
                $('#btnSubmit').removeClass('disable-clicks');
            }
            else {
                $('#btnSubmit').addClass('disable-clicks');
            }
        }

        function SavePersMastrSetUp(strSetUpCd) {
            ////debugger;
            var Mrno = ($.session.get('PatMRNO'));
            var strTran = ($.session.get('PatTRANNO'))
            var strPatName = $.session.get('PatName').toString();
            var strPatAge = ($.session.get('PatAge2') == undefined || $.session.get('PatAge2') == null) ? "" : $.session.get('PatAge2').toString();
            var strPatGender = ($.session.get('PatGender') == undefined || $.session.get('PatGender') == null) ? "" : $.session.get('PatGender').toString();
            var strPatMobile = ($.session.get('PatMobile') == undefined || $.session.get('PatMobile') == null) ? "" : $.session.get('PatMobile').toString();
            $.ajax({
                url: '../DoctorDesk/SavePerMasterSetUp',
                data: { strTran: strTran, strMrNo: Mrno, strSetUpCd: strSetUpCd, strPatName: strPatName, strPatAge: strPatAge, strPatGender: strPatGender, strPatMobile: strPatMobile },
                datatype: 'json',
                type: 'post',
                success: function (response) {
                    if (response.toUpperCase().indexOf("SUCCESSFUL") != -1) {
                        $.alert('Set Up applied successfully');
                        if ((window.location.href).indexOf("RxNewSearch") > -1) {
                            window.location.href = 'RxNewSearch';

                        }
                        else if ((window.location.href).indexOf("PatientAdvice") > -1) {
                            window.location.href = 'PatientAdvice';

                        }
                        else if ((window.location.href).indexOf("Complaints") > -1) {
                            window.location.href = 'Complaints';

                        }
                        else if ((window.location.href).indexOf("Vitals") > -1) {
                            window.location.href = 'Vitals';

                        }
                        else if ((window.location.href).indexOf("Diagnosis") > -1) {
                            window.location.href = 'Diagnosis';

                        }
                        else if ((window.location.href).indexOf("Examination") > -1) {
                            window.location.href = 'Examination';

                        }
                        else if ((window.location.href).indexOf("InvestigationTran") > -1) {
                            window.location.href = 'InvestigationTran';

                        } else if ((window.location.href).indexOf("PrescriptionPrint") > -1) {
                            window.location.href = 'PrescriptionPrint';

                        }
                        GetAllCounts();
                    }
                    else {
                        $.alert(response);
                    }

                }
                , error: function (XMLHttpRequest, textStatus, errorThrown) {
                    HoldOn.close();//
                    $.messager.alert("Error", errorThrown);
                },
            });
        }
