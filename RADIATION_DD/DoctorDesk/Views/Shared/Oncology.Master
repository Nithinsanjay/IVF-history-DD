                            $("div#Divprescriptn")[0].style.backgroundColor = (data["PRESCRIPTN"] === "Y") ? 'rgb(203, 245, 203)' : 'transparent';
                            $("div#DiagnosisPrim")[0].style.backgroundColor = (data["DIAGNOSIS"] == "Y" || data["ICDDIAGNOSIS"] == "Y") ? 'rgb(203, 245, 203)' : 'transparent';
                            $("div#ClinicalHistory")[0].style.backgroundColor = data["CLINICALNOTES"] == "Y" ? 'rgb(203, 245, 203)' : 'transparent';
                            $("div#chemoplan")[0].style.backgroundColor = data["CHEMOPLAN"] == "Y" ? 'rgb(203, 245, 203)' : 'transparent';

