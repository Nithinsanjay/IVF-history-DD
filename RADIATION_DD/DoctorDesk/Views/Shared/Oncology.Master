                        if (result.jsonAllergy != "") {
                            strPrintData = [];
                            var tempData = "<div class='panel' style='margin-bottom: 10px;background-color: #f9f9f9;border-radius: 4px;-webkit-box-shadow: -1px 2px 2px #d0d0d0;'><div class='panel-heading divHeads' style='background: #ceefff !important;font-weight: 600;color: #025882;padding: 5px 11px;border-bottom: 1px solid transparent;'>Allergy</div>    <div class='divBody' style='padding:10px;'>";

