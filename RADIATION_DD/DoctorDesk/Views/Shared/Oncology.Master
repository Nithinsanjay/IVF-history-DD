    <link href="../Content/style.css" rel="stylesheet" />
    <style>
        .btn-default:active:hover, .btn-default.active:hover {
           color: #fff;
    background-color: #31b0d5;
    border-color: #269abc;
        }


        .btn-default:active,
        .btn-default.active,
        .open > .dropdown-toggle.btn-default {
          color: #fff;
    background-color: #31b0d5;
    border-color: #269abc;
        }


         .panel-heading {
    padding: 5px 15px;
    border-bottom: 1px solid transparent;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    background: #6380bb !important;
    color: white;
}

           /*Added By Priyanka on 31/01/2025*/
             .Sdropdown {
            position: relative;
            display: inline-block;
        }
        .Sdropdown-content {
            display: none;
            position: absolute;
            background-color: #ffffff;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 10000000000;
            right: 0;
            border-radius: 5px;
        }
            .Sdropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
                border-bottom: 1px solid #e4e4e4;
                font-size: 13px;
                border-radius: 5px;
            }
                .Sdropdown-content a:hover {
                    background-color: #ddd;
                }
        .Sdropdown.active .Sdropdown-content {
            display: block;
        }
    </style>

    <style>
        #DivOverlay {
            width: 100vw;
            height: 100vh;
            position: fixed;
            top: 0;
            background-color: #80808085;
            z-index: 10000000000000000000000000000000000000;
            justify-content: center;
            align-items: center;
        }

        .MainDivAlertSave {
            background-color: white;
            max-width: 90vw;
            min-width: auto;
        }

        .MainDivHeaderAlert {
            background-color: #003b79;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            font-size: 14px;
            padding: 5px 0px;
        }

        .MainAlertHeadLbl {
            margin: 0;
            padding-left: 5px;
        }

        .MainAlertCloseIcon {
            padding-right: 5px;
            font-size: 20px;
            color: red;
            cursor:pointer;
        }
            .MainAlertCloseIcon:hover {
                color: white;
            }

        .MainDivContentAlert {
            padding: 10px;
            max-height: 70vh; /* You can adjust this as needed */
            overflow-y: auto;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .fancy-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            .fancy-table thead {
                background: #4CAF50;
                color: white;
            }

            .fancy-table th, .fancy-table td {
                padding: 12px 15px;
                text-align: center;
                border-bottom: 1px solid #ddd;
                border-right: 1px solid #ddd;
            }

            .fancy-table tbody tr:nth-child(even) {
                background-color: #f9f9f9;
            }

            .fancy-table tbody tr:hover {
                background-color: #f1f1f1;
                transition: 0.3s ease-in-out;
            }

        /* Responsive tweaks */
        @media screen and (max-width: 600px) {
            .fancy-table th, .fancy-table td {
                padding: 10px;
                font-size: 14px;
            }
        }

        .MainDivFooterAlert {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 7px;
            border-top: 1px solid #d3d3d3;
        }

        .NotesCount {
            top: 0px !important;
        }

        .PopupNotesNotifi {
            display: block;
            position: absolute;
            z-index: 2147483647;
            width: auto;
            float: left;
            background: rgb(237, 237, 237);
            padding: 5px;
            border-radius: 5px;
            border: 1px solid rgb(216, 216, 216);
            max-height: 300px;
            max-width: 450px;
            left: auto;
            right: 0;
            overflow: auto;
        }
    </style>

    <script type="text/javascript">
        var StrDocCode = '<%:Session["gDoctCode"]%>';
        var rowNoFrMedTaper = 0;
        var DMSURL = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("LOCALDMSURL")%>'; //meenakshi 
        var CustomeDateRange = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("CustomeDateRange")%>'; // Dhananjay 20240705 
        var NoteTranMode = "1"; 
        var DispDurCritFrPatSrchYN = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("DispDurCritFrPatSrchYN")%>'; // Added by Dhananjay 20240813
        var HideCheckPatInfoIcon = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("DispShowAllPatIcon")%>';  // Added by Dhananjay 20240828 Re
        var ISICDDiagReq = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("isICDDiagnoReq")%>'; //Added By Priyanka
        var ISDiagnoMandatory = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("DiagnosisMandatory")%>';//Added By Priyanka
        var SendEventToSave = [];
        var CalenderFancyClose = false;
        var CalenderActionType = "";
        var TumorActionType = "";
        var QMSCall = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("QMSENABLE")%>'; //Added By RAJAN
        var gDoctCode = '<%: Session["gDoctCode"] ?? "" %>';
        var UNITCODE = '<%: Session["UNITCODE"] ?? "" %>';

        var adminConsoleYN = '<%: ("" + Session["CONSOLEAPPYN"]).ToString().Trim()%>';
        var FormName = "";
        var UnitSel = "";
        var isCheckingUnit = false;
        var SkipUnitSession = false;
        var ErrorType = "";
        var fontFamily = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("PRESCPRINTFONTFAMILY")%>' || 'Cambria';
        var hTextSize = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("PRESCPRINTHEADERFONTSIZE")%>' || '20px';
        var dTextSize = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("PRESCPRINTCONTENTFONTSIZE")%>' || '20px';
        var patientInfoFontFamily = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("PRESCPRINTPATEINTINFOFONTFAMILY")%>' || 'Cambria';
        var patientInfoFontSize = '<%:@OncologyEMR.DataClass.GeneralFunction.GetAppsettingUnitWiseValue("PRESCPRINTPATINETINFOCONTENTFONTSIZE")%>' || '28px';

        $(document).ready(function (e) {
            $(document).ajaxSend(function (e, jqxhr, settings) {
                if (!isCheckingUnit) {
                    isCheckingUnit = true;
                    IsUnitCode(function (isValid) {
                        isCheckingUnit = false;
                        if (!isValid && !SkipUnitSession) {
                            e.stopPropagation();
                            if (ErrorType == "Doctor") {
                                alert("Session Timeout. Please Login Again");
                                window.location.href = "../Account/Login";
                            } else {
                                window.location.href = "../Error/SessionTimeOut";
                            }
                        }
                    });
                }
            });

            function IsUnitCode(callback) {
                $.ajax({
                    type: 'POST',
                    url: '../Account/GetDoctCode',
                    success: function (data) {
                        if (data == "success") {
                            callback(true);
                        } else {
                            ErrorType = data;
                            callback(false);
                        }
                    },
                    error: function () {
                        callback(false);
                    }
                });
            }

            // Added by Dhananjay 20250928
            var sessionPatStatus = sessionStorage.getItem('PatCompleted');
            if (sessionPatStatus && sessionPatStatus == 'Y') {
                hideButtonsOnPages(['Complaints', 'Examination', 'ClinicalNotes', 'Diagnosis', 'InvestigationTran', 'RxDesktop', 'PatientAdvice', 'ChmoPlanning', 'PersonalHist', 'MedicalHist', 'FamilyHist', 'AllergyHist']);
            }

            /*kavita 18-01-19*/
            //Suchita 18-02-2019 
            $('#DivPatGrid').on('hidden.bs.collapse', toggleIconsofDivTab);
            $('#DivPatGrid').on('shown.bs.collapse', toggleIconsofDivTab);
            //end Suchita 18-02-2019  
            //Added By Priyanka on 31/01/2025
            ////debugger;
            //Setting icon for appsetting start
            $('#cogIcon').click(function () {
                document.querySelector('.Sdropdown').classList.toggle('active');
            });

            window.addEventListener('click', function (event) {
                if (!document.querySelector('.Sdropdown').contains(event.target)) {
                    document.querySelector('.Sdropdown').classList.remove('active');
                }
            });
            //For Appsetting
            $('#BtnAppSetting').click(function () {
                window.location.href = "../Account/AppSettingConfig";
            });
            //For ErrorLog
            $('#BtnErrorLog').click(function () {
                window.location.href = "../Account/ErrorLogInfo";
            })
            <%if (("" + Session["PageId"])== "Menu")
            {%>
            $('#SettingDrpdown').css('display', 'block');
            <%}
            else 
            {%>
            $('#SettingDrpdown').css('display', 'none');
            <%}
            %>

            // Setting icon for appsetting end

            if (window.location.pathname == "/Account/MenuList" ||
               window.location.pathname == "/DoctorDesk/PatientEntry") {
                $('#lishome').css('display', 'none');
            } else {
                $('#lishome').css('display', 'block');
            }

            if (DispDurCritFrPatSrchYN == "N") {
                $("#divTodayYest").hide();     // Added by Dhananjay 20240813   
            }

            if (DMSURL == "")
                $("#lisDocuments").hide();

            $('#lishome').click(function () {
                window.location.href = '../DoctorDesk/PatientEntry';
            });

            $('#btnwhtsup').click(function () {
                //window.open("whatsapp://send?phone=+91" + ($.session.get('PatMobile')));
                window.location.href = "whatsapp://send?phone=+91" + ($.session.get('PatMobile'));
            });
            ////debugger;

            var strMrNo = $.session.get('PatMRNO');
            //var diagnosisselect = $.session.set('Diagnosisselect', localStorage.getItem('DiagnosisSelYN'));

            //previousUserCookie["strMrNo"] = previousUserID;
            //previousUserCookie.Expires = DateTime.Now.AddDays(30);

            //added by priyanka on 19/02/2025
            //if (window.location.href === "../DoctorDesk/PatientEntry")//added by priyanka on 19/02/2025 not working on the uat
            //{
            //    var strMrNo = $.session.get('PatMRNO');
            //    if (strMrNo != null && strMrNo != "") {
            //        SetCountsForHistory(strMrNo); // Call only when URL matches
            //    }
            //}

            //SetCountsForHistory(strMrNo);//commented by priyanka on 19/02/2025

            SetRightMenuOptionFocus();

            if ($.session.get('OutRefDrNm') != "" && $.session.get('OutRefDrNm') != undefined) {
                $("#ReferDrPanel").css('display', 'inline-block');
            } else {
                $("#ReferDrPanel").css('display', 'none');
            }

            if (("" + '<%:Session["PageId"]%>') == "Menu") {
                // $("#menuDots").hide(); suchita   07-03-2019   
                $("#slide_sdList").hide();//kavita 12-aug
            }
            else {
                if (("" + '<%:Session["FromClinic"]%>') == "Y")// added by vijeta on 5th april 2018
                    $("#menuDots").hide();
                else if ($(window).width() < 996)//added by kavita 
                {
                    $("#menuDots").show();//added by kavita 
                    $("#slide_sdList").hide();//kavita 12-aug
                    //$("#P_Name").css('width', '145px');//kavita
                }
                else if ($(window).width() > 996 && $(window).width() <= 1024)//added by kavita 
                {
                    $("#P_Name").css('width', '187px');
                }
                else {
                    $("#slide_sdList").show();//kavita 12-aug
                    SetCountsForHistory(strMrNo);//commented by priyanka on 19/02/2025
                    $("#P_Name").css('width', 'auto');//kavita
                }
            }

            // Meenakshi 28/07/2018
            $('.content-wrapper').css('margin-left', function () {
                if ($(window).width() >= 996)
                    return $("#menuList").width() + 1;
            });

            // Meenakshi 28/07/2018
            $(window).resize(function () {
                $('.content-wrapper').css('margin-left', function () {
                    if ($(window).width() >= 996)
                        return $("#menuList").width() + 1;
                });
            });

            $("#anchrSignOut").click(function () {
                //debugger;
                $.session.set('PatTRANNO', "");
                $.session.set('PatMRNO', "");
                $.session.set('PatName', "");
                $.session.set('PatAge', "");
                $.session.set('PatAge2', "");//added on 25th june 2018
                $.session.set('PatGender', "");
                $.session.set('PatCompleted', "");
                $.session.set('ClinicCode', "");

                $.session.set('ICUPatName', '');
                $.session.set('ICUPatGender', '');
                $.session.set('ICUPatIPNO', '');
                $.session.set('ICUPatMRNO', '');
                $.session.set('ICUPatBedNo', '');
                $.session.set('ICUPatAdmnDate', '');
                /// Meenakshi
                $.session.set('PatSelected', '');
                $.session.set('Pagefrom', '');
                $.session.set('ClinicName', '');
                $.session.set('PatMobile', '');
                $.session.set('PatDOB', '');
                $.session.set('OutRefDrNm', '');
                $.session.set('OutRefDrContact', '');

                //// meenaskhi
                //sessionStorage.clear();

                //Meenakshi
                //for (key in sessionStorage) {
                //    delete sessionStorage[key];
                //}
                //for (key in localStorage) {
                //    delete localStorage[key];
                //}
                //meenakshi
            });

            $('.dropdown-toggle').dropdown();
            var menuL = document.getElementById('menuList');

            $('#menuBar').click(function (e) {
                menuL.style.display = "block";

                var pg = '<%=System.Web.HttpContext.Current.Session["PageId"]%>';
                if (pg != "Menu") {
                    var urls = "<%=Url.Action("GetDctrClinic","Account")%>";
                    AddClinics(urls, "Y");
                }
                else { //added by kavita 30-8-18
                    var patList = document.getElementById('patList');
                    patList.style.display = "none"; //suchita 
                    var urls = "<%=Url.Action("GetDctrClinic","Account")%>";
                    AddClinics(urls, "Y");
                }//added by kavita 30-8-18
            });
            $("#btnHome").click(function () {
                ////debugger;
                //Meenakshi change the url redirection to patient entry page from internal pages..
                var page = window.location.href;
                if (page.indexOf("MenuList") != -1) {
                    GoToHome();
                }
                else if (page.indexOf("PatientEntry") != -1 || page.indexOf("PAC") != -1) {
                    window.location.replace("<%=Url.Action("MenuList", "Account")%>");
                    $.session.set('PatName', '');
                    $.session.set('PatAge', '');
                    $.session.set('PatGender', '');
                    $.session.set('PatMobile', '');
                    $.session.set('PatAge2', '');
                    $.session.set('PatMRNO', '');
                    $.session.set('PatTRANNO', '');
                    $.session.set('PatCompleted', '');
                    $.session.set('ClinicCode', "");
                    $.session.set('OutRefDrNm', '');
                }
                else {
                    window.location.replace("<%=Url.Action("PatientEntry", "DoctorDesk")%>");
                }
            });

            var lst = document.getElementById('sideList');
            var mainContent = document.getElementById('secCont');
            $('#menuDots').click(function (e) {
                $("#sideList").toggle();
                if ($('#divtabs').css('display') != 'none') {
                    lst.style.display = "block";
                    $("#divAdmSideList").show();
                }
            });

            $('#historyPanel').click(function (e) {
                if (document.getElementById("ReferralNotificationPopup").style.display == "block") {
                    $("#ReferralNotificationPopup").slideToggle();
                }
                $("#tblHistDiv").slideToggle();
            });

            $('#TumorPanel').click(function (e) {
                if (document.getElementById("ReferralNotificationPopup").style.display == "block") {
                    $("#ReferralNotificationPopup").slideToggle();
                }
                $("#tblTumorDiv").slideToggle();
            });
            //Meenakshi
            $("#btnShowPatInfo").fancybox({
                openEffect: 'elastic',
                openSpeed: 100,
                closeEffect: 'elastic',
                closeSpeed: 100,
                helpers: {
                    overlay: { closeClick: false }
                },
                autoDimensions: false,
                cyclic: true,
                showNavArrows: true,
            });

            $("#PatHistory").click(function (e) {
                var Mrno = ("" + $.session.get('PatMRNO')).toString();
                if (Mrno != "" && Mrno != "undefined")
                    $("#btnShowPatHistory").click();
                else
                    $.messager.alert("Alert", "Please Select Patient");
            });

            $("#PatInfo").click(function (e) {
                var Mrno = ("" + $.session.get('PatMRNO')).toString();
                if (Mrno != "" && Mrno != "undefined") {
                    $("a#btnShowPatInfo").click();
                    GetPatData(Mrno);
                }
                else
                    $.messager.alert("Alert", "Please Select Patient");
            });

            $('#ReferDrPanel').click(function (e) {
                document.getElementById("tblRefDoctor").innerHTML = "";
                $("#tblRefDoctor").slideToggle();
                var strHtml = "<div>" + $.session.get('OutRefDrNm') + "</br>" + $.session.get('OutRefDrContact') + "</div>";
                document.getElementById("tblRefDoctor").innerHTML = strHtml;
            });

            $('#ReferDrNotesListPanel').click(function (e) {
                if (document.getElementById("tblHistDiv").style.display == "block") {
                    $("#tblHistDiv").slideToggle();
                }
                if (document.getElementById("tblTumorDiv").style.display == "block") {
                    $("#tblTumorDiv").slideToggle();
                }
                $("#ReferralNotificationPopup").slideToggle();
            });
            
            window.onclick = function (event) {

                if (event.target == menuL) {
                    document.getElementById('menuList').style.display = "none";
                }
            }

            window.onclick = function (event) {

                // added by vijeta on 7th april 2018
                if (event.target == document.getElementById('menuDots')) {
                    //lst.style.display = "block"; kavita
                }
                else if (event.target == document.getElementById('slide_sdList') || event.target == document.getElementById('Divarrow')) {
                    //kavita 12-aug-2019
                    $(".rotateArrow").toggleClass("up");
                    $("#sideList").toggle();
                    $('.content-wrapper').css("width", "79.5%");

                    if ($('#sideList').is(":visible")) {
                        SetCountsForHistory(strMrNo);//commented by priyanka on 19/02/2025
                        $('#MainDiv').css("margin-right", "20%");
                        if (window.location.href.indexOf("RxNewSearch") != -1) {
                            $('#ComplaintInput').css("width", "55%");
                        }
                        if (window.location.href.indexOf("Examination") != -1) {
                            $('#ExamDiv').css("width", "80%");
                        }

                    } else {
                        $('#MainDiv').css("margin-right", "0%");
                        if (window.location.href.indexOf("Examination") != -1) {
                            $('#ExamDiv').css("width", "100%");

                        }
                        if (window.location.href.indexOf("RxNewSearch") != -1) {
                            $('#ComplaintInput').css("width", "48%");

                        }
                    }
                }
                else {

                    if ($(window).width() >= 996) {
                        //  lst.style.display = "block";
                    }
                    else {
                        $("#slide_sdList").css("display", "none");   //kavita 12-aug-2019
                        if (event.target != document.getElementById('txtNotes') && event.target != document.getElementById('btnSaveNotes')) // condition added by vijeta on 16th may 2018
                            lst.style.display = "none";
                    }
                }
            }

            panelClose.onclick = function () {
                menuL.style.display = "none";
            }

            $('#btnClose').click(function (e) {
                Makenormal();
                RemoveBorder();
            });

            //$("body").disableSelection();

            $("body").keydown(function (e) {
                if (e.keyCode == 8) {
                    var element = e.target.nodeName.toLowerCase();
                    if (element != 'input' && element != 'textarea') {
                        return false;
                    }
