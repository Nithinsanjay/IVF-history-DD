            });

            $("#startDate").datepicker({

                dateFormat: 'yy-mm-dd', // Date format
                zIndex: 9999,
                maxDate: '0',
                minDate: -CustomeDateRange,   // Config Value fetch here
                beforeShow: function (input, inst) {
                    setTimeout(function () {
                        $('#ui-datepicker-div').css('z-index', 9999999);
                        $('#startDate').css('display', 'none');
                    }, 0);
                },
                onSelect: function (selectedDate) {

                    // Conversion- diff from current date
                    var selectedDateObj = new Date(selectedDate);
                    var currentDateObj = new Date();
                    var timeDifference = currentDateObj.getTime() - selectedDateObj.getTime();
                    var daysDifference = Math.ceil(timeDifference / (1000 * 3600 * 24));

                    if (daysDifference) {
                        SearchFunction($.session.get('ClinicCode'), "D", daysDifference - 1)
                    }
                }
            });

