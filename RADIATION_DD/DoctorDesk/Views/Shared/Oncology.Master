                            if (result.jsonFreeMedical != "") {
                                tempData += "<table style='width:90%;border-collapse:collapse;border:1px solid gray;margin-left:22px;' class='tblFree'>";
                                for (var i = 0; i < result.jsonFreeMedical.length; i++) {
