        }

        function OpenUnitSel() {
            var curFormURL = ("" + '<%= Request.Url.AbsolutePath %>').toString().toUpperCase().trim();
            var loadedFormName = curFormURL.substr(curFormURL.lastIndexOf("/") + 1);
            if (loadedFormName.toUpperCase() == "MENULIST" && '<%:Session["SINGLEUNITYN"]%>' == "N") {
                $("a#btnHospUnitDiv").click();
            }
        }

        function PatTumorTreatmentDet() {
            ////debugger;
            var tranNo = ($.session.get('PatTRANNO'));
            var mrNo = ($.session.get('PatMRNO'));// added by vijeta on 23rd May

            if (mrNo == "" || mrNo == null || mrNo == undefined) {
                return;
            }
            $.ajax({
                type: "POST",
                url: '../DoctorDesk/PatTumorTreatmentDet',
                datatype: "json",
                async: true,
                data: { strMrNo: mrNo },
                success: function (result) {
                    renderTreatmentDetails(result);
                },
                complete: function () {
                    HoldOn.close();//
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) { HoldOn.close(); }//
            });
        }
        function OpenUnitSel() {
            var curFormURL = ("" + '<%= Request.Url.AbsolutePath %>').toString().toUpperCase().trim();
            var loadedFormName = curFormURL.substr(curFormURL.lastIndexOf("/") + 1);
            if (loadedFormName.toUpperCase() == "MENULIST" && '<%:Session["SINGLEUNITYN"]%>' == "N") {
                $("a#btnHospUnitDiv").click();
            }
        }
        function renderTreatmentDetails(resultArray) {
            $("#tblTumorDiv").empty(); // clear existing content

            if (resultArray && resultArray.length > 0) {
                var mainContainer = document.getElementById("tblTumorDiv");
                mainContainer.innerHTML = ""; // clear old content

                // Common heading once at the top
                var headingHTML = "<div class='panel-heading divHeads' " +
                                  "style='background:#3b5998 !important;font-weight:700;" +
                                  "color:white;padding:8px 12px;margin-bottom:8px;" +
                                  "border-radius:4px;'>Treatment Details</div>";
                mainContainer.innerHTML += headingHTML;

                // Add all treatments
                for (var i = 0; i < resultArray.length; i++) {
                    var tr = resultArray[i];
                    var tempData =
                        "<div class='panel' style='margin-bottom:10px;background-color:#f9f9f9;" +
                        "border-radius:4px;-webkit-box-shadow:-1px 2px 2px #d0d0d0;'>" +
                            "<div class='panel-heading divHeads' style='background:#ceefff !important;font-weight:600;" +
                            "color:#025882;padding:5px 11px;border-bottom:1px solid transparent;'>" +
                                tr.TREATMENTNAME +
                            "</div>" +
                            "<div class='divBody' style='padding:10px;'>" +
                                "<span style='font-weight:600;'>Treatment: </span>" + tr.TREATMENTDET + "<br/>" +
                                "<span style='color:#555;font-size:13px;'>Date: " + tr.TREATMENTDATE + "</span><br/>" +
                                "<span style='color:#777;font-size:12px;'>Remarks: " + tr.REMARKS + "</span>" +
                            "</div>" +
                        "</div>";
                    mainContainer.innerHTML += tempData;
                }
            } else {
                var mainContainer = document.getElementById("tblTumorDiv");
                mainContainer.innerHTML = ""; // clear old content

                var noDataHTML =
                    "<div class='panel-heading divHeads' style='background:#b0e0ff !important;font-weight:700;" +
                    "color:#024e72;padding:8px 12px;margin-bottom:8px;border-radius:4px;'>Treatment Details</div>" +
                    "<div class='panel' style='margin-bottom:10px;background-color:#f9f9f9;" +
                    "border-radius:4px;-webkit-box-shadow:-1px 2px 2px #d0d0d0;'>" +
                        "<div class='divBody' style='padding:10px;'><div>No Treatment Found.</div></div>" +
                    "</div>";

                mainContainer.innerHTML += noDataHTML;
            }
        }


        function GetReferalNotesList() {
            var Resp = [];
            $.ajax({
                url: '../DoctorDesk/GetReferralNotesList',
                type: "POST",
                datatype: "json",
                async: false,
                success: function (data) {
                    Resp = data;
                }
            });
            return Resp;
        }

        function BindReferalNotesList() {
            var NotesLstData = GetReferalNotesList("");
            $("#ReferralNotificationPopup").empty();
            if (NotesLstData.length == 0) {
                var NoDatLbl = "<div class='panel-heading divHeads' style=' background: #ceefff !important;font-weight: 600;color: #025882;padding: 5px 11px;border-bottom: 1px solid transparent;'>No Data.</div>";
                $("#ReferralNotificationPopup").append(NoDatLbl);
                document.getElementById("DRRefNoteCountHint").style.display = "none";
                document.getElementById("DRRefNoteCount").innerText = "";
                document.getElementById("ReferDrNotesListPanel").style.display = "none";
            }
            else {
                for (var i = 0; i < NotesLstData.length; i++) {
                    var formattedNote = NotesLstData[i].NOTE;//NotesLstData[i].NOTE.replace(/\n/g, "<br/>");
                    var MainPanel = "<div class='panel' style='margin-bottom: 10px;background-color: #ffffff;border-radius: 4px;-webkit-box-shadow: -1px 2px 2px #d0d0d0;padding: 10px;color: black;width: 100%;'>{PANELCONTENT}</div>";
                    var Statement = "<label style='width: max-content;'><b>Dr." + NotesLstData[i].REFBYDOCTOR + "</b> referred <b>" + NotesLstData[i].PATNAME + "</b> with the note: '" + formattedNote + "'</label>";
                    var RplMainPanel = MainPanel.replace("{PANELCONTENT}", (Statement));
                    $("#ReferralNotificationPopup").append(RplMainPanel);
                }
                document.getElementById("DRRefNoteCountHint").style.display = "inline-block";
                document.getElementById("DRRefNoteCount").innerText = NotesLstData.length;
                if (NotesLstData.length <= 9) {
                    document.getElementById("DRRefNoteCount").style.right = "-10x !important";
                }
                else if (NotesLstData.length <= 99) {
                    document.getElementById("DRRefNoteCount").style.right = "-13x !important";
                }
                else {
                    document.getElementById("DRRefNoteCount").style.right = "-16px !important";
                }
                document.getElementById("ReferDrNotesListPanel").style.display = "inline-block";
            }
        }

        function GetPatReferalNotes() {
            var Resp = [];
            if ($.session.get('PatTRANNO') != "" && $.session.get('PatTRANNO') != null && $.session.get('PatMRNO') != "" && $.session.get('PatMRNO') != null) {
                $.ajax({
                    url: '../DoctorDesk/GetPatReferralNotes',
                    type: "POST",
                    datatype: "json",
                    async: false,
                    data: { TranNo: $.session.get('PatTRANNO'), Mrno: $.session.get('PatMRNO') },
                    success: function (data) {
                        Resp = data;
                    }
                });
            }
            return Resp;
        }

        function BindPatRefNote() {
            var NotesLstData = GetPatReferalNotes();
            $("#DivNotesContent").empty();
            if (NotesLstData.length == 0) {
                document.getElementById("ReferDrNotesPanel").style.display = "none";
            }
            else {
                document.getElementById("ReferDrNotesPanel").style.display = "inline-block";
                $("#DivNotesContent").empty();
                for (var i = 0; i < NotesLstData.length; i++) {
                    var MainDiv = '<div style="border: 1px solid grey;padding: 5px;">{MAINDIVCONTENT}</div>';
                    var RefByDiv = '<div><label style="margin: 0px;">Referred By</label><label style="padding: 0px 5px;">:</label><label>Dr.{REFERREDBYDOCT}</label></div>';
                    var NoteHeadDiv = '<div><label style="text-decoration: underline;margin: 0px;">Note :</label></div>';
                    var NoteContDiv = '<div>{NOTECONTENT}</div>';
                    var formattedNote = NotesLstData[i].NOTE.replace(/\n/g, "<br/>");
                    var RplRefByDiv = RefByDiv.replace("{REFERREDBYDOCT}", NotesLstData[i].REFBYDOCTOR);
                    var RplNoteContDiv = NoteContDiv.replace("{NOTECONTENT}", formattedNote);
                    var RplMainDiv = MainDiv.replace("{MAINDIVCONTENT}", (RplRefByDiv + NoteHeadDiv + RplNoteContDiv));
                    $("#DivNotesContent").append(RplMainDiv);
                }
                if ($.session.get('SHOWNOTES') == "Y" && $.session.get('PatTRANNO') != "" && $.session.get('PatTRANNO') != null) {
                    $("a#btnShowRefDRNotesInfo").click();
                    $.session.set('SHOWNOTES', "");
                }
            }
        }
    </script>

    <%-- Calender Popup --%>
    <script type="text/javascript">
        function OpenCloseAlert(Type, ID) {
            if (Type == "O") {
                document.getElementById("DivOverlay").style.display = "flex";
                document.getElementById(ID).style.display = "block";
            }
            else {
                document.getElementById("DivOverlay").style.display = "none";
                document.getElementById(ID).style.display = "none";
            }
        }
    </script>

</head>

