		<add key="PRESCRIPTION_FILE_PATH" value="" />
		<add key="SQS_ENABLE" value="N" />
		<!--End-->
		<!--Added By Murali on 18/06/2024-->
		<add key="DiagnosisMandatory" value="N" />
		<!--Added By Murali on 18/06/2024-->
		<add key="ShowRoutinefeature" value="N" />
		<!--Added By Dhananjay on 20240705-->
		<add key="CustomeDateRange" value="150" />
		<!--To auto complete on precription pritn from Temp1, Temp2 or temp3 Menakshi-->
		<add key="AutoCompltOnPrintPrescritpion" value="Y" />
		<!--Added By Murali on 07/08/2024 to print the prescription directly after completing the patient consultation set to "Y"-->
		<add key="DirectPrint" value="Y" />
		<!--Added by Dhananjay 20240813  "N" - Not Display ,  "" - Display , ( Purpose: Control the visibility Hide Today,Yest,Day Befr,Custom Based on this Value ) -->
		<add key="DispDurCritFrPatSrchYN" value="Y" />
		<!--Added by Dhananjay 20240828  "N" - Not Display ,  "" - Display , ( Purpose: Control the visibility of the "Show All Patient List" icon  ) -->
		<add key="DispShowAllPatIcon" value="Y" />
		<!--EHR (Doctor Desk) / Triage ! Added By :Raja ! 21/02/2025 18:50 ! Added by Dhananjay 20241005 ,  "Y" - To Display  ( Pupose - Control the Visibility of "Refer to Tumor Board" Checkbox in PrescriptionPrint.aspx) ! Print Presciption-->
		<add key="SHOWTBREF" value="Y" />
		<!--Discharge Summary ! Added By :Meenakshi ! 09-09-2024 11:28 ! To set the path to save the DS PDF file Copy of patients to show in patient portal & doctor desk ! Discharge Summary-->
		<add key="DSPDFDocumentPath" value="C:\\DSDocument" />
		<!--EHR (Doctor Desk) / Triage ! Added By :Ashvini ! 15/11/2024 11:19 ! Added Key to allow or not allow Mail before prescription completion . ! PrescriptionPrint-->
		<add key="AllowMailBeforePrescriptionCompl" value="N" />
		<!--EHR (Doctor Desk) / Triage ! Added By :Ashvini ! 25/11/2024 13:31 ! Added Key to display or hide the filter div in Medication History  . ! MedicationHistory-->
		<add key="DispSrchCritInMedHistory" value="N" />
		<!--Added By Murali on 25/10/2024 Use A:Auto suggect, M: Manual, Blank to skip-->
		<add key="QMSENABLE" value="Y" />
		<!--Added By Rajan on 08/11/2024  - For Show Patient Care Type in Prescription  -->
		<add key="PRESCRIPTIONCARETYPESHOWYN" value="N" />
		<!--Added By Rajan on 08/11/2024  - For Calculate the Qty Based on Frequency - TabletCount, No.of Days , Days in RX -->
		<add key="CALCQTYBASEDFREQRX" value="Y" />
		<!--Added By Rajan on 25/07/2025  - For Generic Wise Data Set as "Y" other wise Medicine Wise -->
		<add key="GENERICWISEDATAYN" value="Y" />
		<!--to  link to Dicom viewer sample collection on intranet-->
		<add key="LocalDicomURLSampleCol" value="http://localhost:8084/sampleviewer/INDEX?SAMPLENO=" />
		<!--Link For the Palliative Care History-->
		<add key="PALLIATIVECAREHISTORY" value="http://192.168.1.3:81/PalliativeCare/CallPalliativeCareList" />
		<!-- 
      Added by Roshan on 12/10/2025
      Config for CIMS Integration
      Setting IS_DISPLAY_CIMS_INTEGRATION to "Y" to enable integration , "N" to disabled integration
 -->
		<add key="IS_DISPLAY_CIMS_INTEGRATION" value="Y" />
		<!-- Doctor Desk ! To hide and show vitals in prescription print !Priyanka 26/12/2025 -->
		<add key="ShowVitalsExtraFieldsinPrescPrint" value="Y"/>
		<!-- Doctor Desk ! Go With New UI or Old UI -->
		<add key="NewUI" value="Y"/>

		<!-- to set hospital name-->
		<add key="SetHospitalNm" value="RCHRC"/>

    <!--DoctorDesk ! Added By :Priyanka ! 10/04/2026 ! :To set the defualt Font family  ||  Arial, Other font name-->
    <add key="CkEditorDefFontfamily" value="Arial" />
    <!--DoctorDesk ! Added By :Priyanka ! 10/04/2026 ! :To set the defualt Font size  ||  18px, Other font size-->
    <add key="CkEditorDefFontSize" value="18px" />

    <!--DoctorDesk ! Added By :Priyanka ! 10/04/2026 ! :To Show and Hide Clinical Notes TextArea ||  18px, Other font size-->
    <add key="ShowClinicalNotesFreeText" value="N" />

    <!--DoctorDesk ! Added By :Priyanka ! 11/04/2026 ! :To Show and Hide History Edit Button in OPD -->
    <add key="RMOHISTORYYN" value="Y" />
    <!--
        Author        : Dhananjay
        Date          : 2026-04-07
        Feature       : Blinking Functionality for Selected Forms

        Description   :
        Enables blinking functionality for specific forms within the CIMS module.

        Applicable Forms :
        - TrmtntOrderMedicineTable
        - ChemoListtable
        - RxListtable
        - ChemoPlanningTable

        Configuration :
        Provide a comma-separated list of form short codes for which blinking
        functionality should be enabled.

        Example :
          -> TrmtntOrderMedicineTable
          -> ChemoListtable
          -> RxListtable
          -> ChemoPlanningTable
          -> TrmtntOrderMedicationTable
          -> PreOPMeds
          -> Medicine
    -->
          <add key="CIMS_BLINKING_ENABLE_FORMS" value="TrmtntOrderMedicineTable,ChemoListtable,RxListtable,ChemoPlanningTable,TrmtntOrderMedicationTable,PAC"/>

          <!--
				Author        : Dhananjay
				Date          : 2026-04-07
				Feature       : Enable Button Icons

				Description   :
				Controls the visibility of button icons based on configuration values.

				Configuration :
				Key   : CIMS_VISIBLE_ICONS
				Value : Comma-separated short codes representing icons to display.

				Supported Codes :
						I - Interaction
						D - Duplicate
						A - Allergy

				Example :
						I,D,A   → Displays Interaction, Duplicate, and Allergy icons
		-->
          <add key="CIMS_VISIBLE_ICONS" value="I" />

        </appSettings>
</configuration>