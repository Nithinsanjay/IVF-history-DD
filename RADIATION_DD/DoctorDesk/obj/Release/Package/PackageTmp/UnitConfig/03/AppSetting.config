		<add key="DispLanguage" value="Y"></add>
		<!--To display the bottom line on prescription-->
		<add key="PrescBottomLine1" value="ఔషధాలను సాధారణ (జెనరిక్) పేర్లతో కూడా సూచించారు. రోగులు మెడికల్ షాప్ / ఫార్మసీ నుండి జెనరిక్ ఔషధాలు లేదా సమానమైన ఔషధాలను స్వేచ్ఛగా తీసుకోవచ్చు." />
		<add key="PrescBottomLine2" value="The medicines have been prescribed in the generic names too. The patients are free to take the generic medicines / equivalent medicines from the medical store / pharmacy." />
